  // CRM CUSTOMER TABLE FILTER
  function filterCustomerTable(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.cust-row');
    let count = 0;
    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const phone = row.getAttribute('data-phone') || '';
      const notes = row.getAttribute('data-notes') || '';
      if (name.includes(q) || phone.includes(q) || notes.includes(q)) {
        row.style.display = '';
        count++;
      } else {
        row.style.display = 'none';
      }
    });
    const badge = document.getElementById('crm-total-badge');
    if (badge) badge.textContent = `${count} Pelanggan`;
  }

