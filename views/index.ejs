                  <input type="number" id="input-weight" step="0.1" min="0.5" value="3.5" oninput="calculateTotal()" class="flex-1 text-center py-2 text-sm font-black rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-mono">
