    <div id="tab-pengaturan" class="hidden space-y-6">
      
      <!-- Top Action Bar -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-lg font-black text-slate-900 tracking-tight">Pengaturan Toko</h2>
          <p class="text-xs text-slate-500 font-medium">Informasi profil cabang dan kesehatan infrastruktur PostgreSQL.</p>
        </div>
        <button onclick="switchTab('dashboard')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold rounded-xl transition flex items-center space-x-1.5">
          <span>← Kembali ke Antrean</span>
        </button>
      </div>


      <!-- PROFIL KASIR & TOKO -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200">
          <div class="flex items-center space-x-2">
            <span class="text-xl">👤</span>
            <div>
              <h3 class="font-black text-sm text-slate-900">Profil Kasir Aktif</h3>
              <p class="text-xs text-slate-500 font-medium">Akun kasir yang sedang login di sesi ini.</p>
            </div>
          </div>
          <button onclick="bukaModalEditKasir()" class="px-3 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold rounded-xl transition border border-teal-200 flex items-center gap-1">
            <span>✏️</span> Edit Profil Kasir
          </button>
        </div>
