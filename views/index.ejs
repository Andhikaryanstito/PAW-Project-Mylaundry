  // UBAH STATUS ANTREAN (SIAP / DIPROSES)
  async function cycleStatus(id) {
    const order = orderList.find(o => o.id === id);
    if (!order) return;

    let nextStatus = 'Diproses';
    if (order.status === 'Diproses') nextStatus = 'Siap Diambil';
    else if (order.status === 'Siap Diambil') nextStatus = 'Menumpuk';
    else nextStatus = 'Diproses';

    order.status = nextStatus;

    try {
      await fetch(`/api/pesanan/${encodeURIComponent(id)}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nextStatus })
      });
    } catch (e) {
      console.warn('API status update error:', e);
    }

    window.location.reload();
  }

  // ── MODAL UPDATE STATUS PEMBAYARAN (PELUNASAN KASIR) ───
  let activePelunasanOrder = null;

  function bukaModalPelunasan(id, name, price, currentStatus, currentMethod) {
    activePelunasanOrder = { id, name, price, currentStatus, currentMethod };
    
    document.getElementById('pay-modal-order-id').textContent = id;
    document.getElementById('pay-modal-cust-name').textContent = name;
    document.getElementById('pay-modal-total-price').textContent = 'Rp ' + Number(price || 0).toLocaleString('id-ID');
    
    const badgeEl = document.getElementById('pay-modal-current-badge');
    if (currentStatus === 'Lunas') {
      badgeEl.className = 'badge-paid px-2.5 py-0.5 rounded-full text-[10px] font-extrabold shadow-2xs';
      badgeEl.textContent = `Lunas (${currentMethod || 'Tunai'})`;
    } else {
      badgeEl.className = 'badge-unpaid px-2.5 py-0.5 rounded-full text-[10px] font-extrabold shadow-2xs';
      badgeEl.textContent = 'Belum Lunas';
    }

    document.getElementById('modal-pelunasan').classList.remove('hidden');
