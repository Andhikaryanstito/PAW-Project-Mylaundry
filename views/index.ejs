  /**
   * Helper untuk memformat teks respon Markdown menjadi HTML yang rapi
   */
  function formatMarkdown(text) {
    if (!text) return '';
    let formatted = text
      // Escape script tags
      .replace(/</g, '&lt;').replace(/>/g, '&gt;')
      // Bold **text**
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      // Italic *text*
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      // Inline code `code`
      .replace(/`(.*?)`/g, '<code class="bg-slate-100 text-rose-600 px-1 py-0.5 rounded text-[11px] font-mono">$1</code>')
      // Numbered list item "1. "
      .replace(/^(\d+)\.\s+(.*)$/gm, '<li class="ml-4 list-decimal my-0.5"><strong>$2</strong></li>')
      // Bullet list item "• " or "- "
      .replace(/^[\•\-\*]\s+(.*)$/gm, '<li class="ml-4 list-disc my-0.5">$1</li>')
      // Newlines to <br>
      .replace(/\n/g, '<br>');
    return formatted;
  }

  /**
   * Helper fungsi utama pengiriman pertanyaan ke Backend Express.js (POST /api/chat)
   */
  async function requestAIChat(userQuestion) {
    const response = await fetch('/api/chat', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ message: userQuestion })
    });

    const json = await response.json();
    return { ok: response.ok, status: response.status, data: json };
  }

