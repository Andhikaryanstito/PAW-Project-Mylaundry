  // ========================
  // TOAST NOTIFICATION SYSTEM
  // ========================
  function showToast(message, type = 'success', duration = 3500) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colors = {
      success: 'bg-teal-800 border-teal-600 text-white',
      error:   'bg-rose-700 border-rose-500 text-white',
      warning: 'bg-amber-600 border-amber-400 text-white',
      info:    'bg-slate-800 border-slate-600 text-white'
    };
    const icons = {
      success: '✓',
      error:   '✕',
      warning: '⚠',
      info:    'ℹ'
    };

    toast.className = `toast-enter flex items-center space-x-3 px-4 py-3 rounded-xl border shadow-lg text-sm font-bold ${colors[type] || colors.info} max-w-sm`;
    toast.innerHTML = `
      <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs font-black flex-shrink-0">${icons[type] || '•'}</span>
      <span class="flex-1 text-xs leading-snug">${message}</span>
      <button onclick="this.parentElement.remove()" class="text-white/70 hover:text-white ml-2 flex-shrink-0 text-base leading-none">×</button>
    `;

    container.appendChild(toast);
    setTimeout(() => {
      toast.style.transition = 'opacity 0.4s, transform 0.4s';
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(100%)';
      setTimeout(() => toast.remove(), 400);
    }, duration);
  }

  function showFeatureAlert(msg) {
    showToast(msg, 'info');
  }

