                      </button>
                      <button onclick="bukaModalEditPelanggan('<%= cust.id %>', `<%= cust.name %>`, `<%= cust.phone %>`, `<%= cust.note || '' %>`)" title="Edit Data Pelanggan" class="px-2 py-1 bg-amber-50 hover:bg-amber-200 text-amber-800 rounded-lg transition border border-amber-200 text-[10px] font-bold">
                        ✏️ Edit
                      </button>
                      <button onclick="hapusPelanggan('<%= cust.id %>', `<%= cust.name %>`)" title="Hapus Pelanggan" class="px-2 py-1 bg-rose-50 hover:bg-rose-200 text-rose-700 rounded-lg transition border border-rose-200 text-[10px] font-bold">
                        🗑️ Hapus
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Modal Edit Data Pelanggan -->
      <div id="modal-edit-pelanggan" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-2xl p-6 w-full max-w-md space-y-4 border border-slate-200 animate-in fade-in">
