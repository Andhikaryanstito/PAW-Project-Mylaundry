<!-- CLIENT-SIDE JAVASCRIPT & STATE MANAGEMENT -->
<script>
  // Inisialisasi data dari backend controller EJS
  const backendProducts = <%- JSON.stringify(products) %>;
  const backendCustomers = <%- JSON.stringify(customers) %>;
  let orderList = <%- JSON.stringify(orders) %>;
  
  let currentFilter = 'all';
  let isRaining = false;
  let selectedPackageRate = backendProducts[0]?.harga || 7000;
  let selectedPackageHours = backendProducts[0]?.estimasi_jam || 48;
  let selectedPackageName = backendProducts[0]?.nama || 'Cuci Reguler';
  let selectedPackageCode = backendProducts[0]?.kode || 'reguler';
  let currentPaymentStatus = 'Lunas';
  let currentPaymentMethod = 'Tunai';
  let currentReceiptOrder = null;
  let isDrawerOpen = false;

  // TAB SWITCHER
  function switchTab(tabId) {
    document.getElementById('tab-dashboard').classList.add('hidden');
    document.getElementById('tab-transaksi').classList.add('hidden');
    document.getElementById('tab-api-tester').classList.add('hidden');
    const tabStatus = document.getElementById('tab-status');
    if (tabStatus) tabStatus.classList.add('hidden');

    document.querySelectorAll('.nav-tab').forEach(el => {
      el.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
      el.classList.add('text-slate-700', 'hover:text-blue-800', 'hover:bg-blue-50/70');
    });

    const targetTab = document.getElementById('tab-' + tabId);
    if (targetTab) targetTab.classList.remove('hidden');

    const activeNav = document.getElementById('nav-' + tabId);
    if (activeNav) {
      activeNav.classList.remove('text-slate-700', 'hover:text-blue-800', 'hover:bg-blue-50/70');
      activeNav.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
    }

    // Jika buka tab status cucian, otomatis muat data pesanan aktif
    if (tabId === 'status') {
      const orderToShow = currentReceiptOrder || orderList[0];
      if (orderToShow) {
        populateStatusCucianTab(orderToShow);
      }
    }
  }

  // GLOBAL TOP SEARCH
  function handleGlobalSearch(val) {
    switchTab('dashboard');
    const query = val.toLowerCase().trim();
    const rows = document.querySelectorAll('.order-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const name = row.getAttribute('data-name');
      const id = row.getAttribute('data-id');
      if (name.includes(query) || id.includes(query)) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('visible-count').textContent = visibleCount;
  }

  // AUTOCOMPLETE PELANGGAN (PRD US-02)
  function handleCustomerAutocomplete(val) {
    const box = document.getElementById('autocomplete-box');
    if (!val || val.trim().length === 0) {
      box.classList.add('hidden');
      return;
    }
    const matches = backendCustomers.filter(c => c.name.toLowerCase().includes(val.toLowerCase()));
    if (matches.length === 0) {
      box.classList.add('hidden');
      return;
    }

    box.innerHTML = '';
    matches.forEach(c => {
      const item = document.createElement('div');
      item.className = "p-2.5 hover:bg-blue-50 cursor-pointer flex justify-between items-center transition";
      item.innerHTML = `
        <div>
          <p class="font-extrabold text-slate-900">${c.name}</p>
          <p class="text-[10px] text-slate-600 font-mono">${c.phone} ${c.note || ''}</p>
        </div>
        <span class="text-[10px] bg-blue-100 text-blue-800 font-black px-2 py-0.5 rounded">Pilih</span>
      `;
      item.onclick = function() {
        document.getElementById('cust-name').value = c.name;
        document.getElementById('cust-wa').value = c.phone.replace(/^0/, '');
        box.classList.add('hidden');
      };
      box.appendChild(item);
    });
    box.classList.remove('hidden');
  }

  // PILIH PAKET
  function selectPackage(kode, rate, hours, name) {
    selectedPackageCode = kode;
    selectedPackageRate = rate;
    selectedPackageHours = hours;
    selectedPackageName = name;

    document.querySelectorAll('.pkg-card').forEach(el => {
      el.className = "pkg-card cursor-pointer rounded-2xl p-4 border-2 border-slate-300 bg-white hover:border-blue-400 text-left transition relative";
    });

    const active = document.getElementById('pkg-' + kode);
    if (active) {
      active.className = "pkg-card cursor-pointer rounded-2xl p-4 border-2 border-blue-600 bg-blue-50/80 shadow-2xs text-left transition relative";
    }
    calculateTotal();
  }

  // TIMBANGAN BERAT
  function stepWeight(delta) {
    const input = document.getElementById('input-weight');
    let val = parseFloat(input.value) || 0;
    val = Math.max(0.5, Math.round((val + delta) * 10) / 10);
    input.value = val;
    calculateTotal();
  }

  function setWeight(val) {
    document.getElementById('input-weight').value = val;
    calculateTotal();
  }

  // STATUS & METODE BAYAR
  function setPaymentStatus(status) {
    currentPaymentStatus = status;
    if (status === 'Lunas') {
      document.getElementById('btn-status-lunas').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-blue-600 bg-blue-100 text-blue-900 transition";
      document.getElementById('btn-status-belum').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400";
    } else {
      document.getElementById('btn-status-belum').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-amber-600 bg-amber-100 text-amber-900 transition";
      document.getElementById('btn-status-lunas').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400";
    }
  }

  function setPaymentMethod(method) {
    currentPaymentMethod = method;
    if (method === 'Tunai') {
      document.getElementById('btn-method-tunai').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-blue-600 bg-blue-100 text-blue-900 transition";
      document.getElementById('btn-method-qris').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400";
    } else {
      document.getElementById('btn-method-qris').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-blue-600 bg-blue-100 text-blue-900 transition";
      document.getElementById('btn-method-tunai').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400";
    }
  }

  // KALKULASI HARGA & JAM SELESAI
  function calculateTotal() {
    const weight = parseFloat(document.getElementById('input-weight').value) || 0;
    const total = Math.round(weight * selectedPackageRate);
    document.getElementById('display-total-price').textContent = total.toLocaleString('id-ID');
    document.getElementById('display-calc-detail').textContent = `${weight} Kg × Rp ${selectedPackageRate.toLocaleString('id-ID')} (${selectedPackageName})`;

    const now = new Date();
    let readyDate = new Date(now.getTime() + (selectedPackageHours * 60 * 60 * 1000));
    if (isRaining) {
      readyDate = new Date(readyDate.getTime() + (3 * 60 * 60 * 1000));
      document.getElementById('weather-buffer-note').textContent = '⚠️ Ditambah buffer +3 jam (hujan)';
      document.getElementById('weather-buffer-note').className = 'text-[10px] text-amber-900 font-black';
    } else {
      document.getElementById('weather-buffer-note').textContent = 'Buffer cuaca normal';
      document.getElementById('weather-buffer-note').className = 'text-[10px] text-slate-600 font-semibold';
    }

    const options = { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' };
    const formatted = readyDate.toLocaleDateString('id-ID', options) + ' WIB';
    document.getElementById('display-ready-time').textContent = formatted;
  }

  // SIMULASI CUACA HUJAN
  function toggleWeather() {
    isRaining = !isRaining;
    const banner = document.getElementById('weather-banner');
    const btnText = document.getElementById('weather-text');
    const btnIcon = document.getElementById('weather-icon');
    const btn = document.getElementById('weather-btn');

    if (isRaining) {
      banner.classList.remove('hidden');
      btnIcon.textContent = "🌧";
      btnText.textContent = "Hujan Lebat";
      btn.className = "px-3.5 py-2 rounded-xl text-xs font-black flex items-center space-x-2 bg-blue-100 text-blue-900 border border-blue-300";
    } else {
      banner.classList.add('hidden');
      btnIcon.textContent = "☀️";
      btnText.textContent = "Cerah (31°C)";
      btn.className = "px-3.5 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-amber-100/80 text-amber-900 border border-amber-300 hover:bg-amber-200/80";
    }
    calculateTotal();
  }

  // FILTER TABEL ANTREAN
  function setFilter(filterType) {
    currentFilter = filterType;
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-blue-600', 'text-white', 'shadow-2xs');
      b.classList.add('hover:text-blue-800', 'hover:bg-slate-200');
    });

    const filterKey = filterType === 'all' ? 'all' : filterType.toLowerCase().replace(/\s+/g, '');
    const activeBtn = document.getElementById('filter-' + filterKey);
    if (activeBtn) {
      activeBtn.classList.remove('hover:text-blue-800', 'hover:bg-slate-200');
      activeBtn.classList.add('bg-blue-600', 'text-white', 'shadow-2xs');
    }
    filterTable();
  }

  function filterTable() {
    const rows = document.querySelectorAll('.order-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const status = row.getAttribute('data-status');
      const matchesFilter = (currentFilter === 'all') || (status === currentFilter);

      if (matchesFilter) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('visible-count').textContent = visibleCount;
  }

  // UBAH STATUS ANTREAN (SIAP / DIPROSES)
  async function cycleStatus(id) {
    const order = orderList.find(o => o.id === id);
    if (!order) return;

    let nextStatus = 'Diproses';
    if (order.status === 'Diproses') nextStatus = 'Siap Diambil';
    else if (order.status === 'Siap Diambil') nextStatus = 'Menumpuk';
    else nextStatus = 'Diproses';

    order.status = nextStatus;

    try {
      await fetch(`/api/pesanan/${encodeURIComponent(id)}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nextStatus })
      });
    } catch (e) {
      console.warn('API status update error:', e);
    }

    window.location.reload();
  }

  // SIMPAN TRANSAKSI & BUKA NOTA
  async function submitTransaction() {
    const name = document.getElementById('cust-name').value.trim() || "Pelanggan Baru";
    const rawWa = document.getElementById('cust-wa').value.trim() || "81234567890";
    const phone = rawWa.startsWith('0') ? rawWa : '0' + rawWa;
    const weight = parseFloat(document.getElementById('input-weight').value) || 3.0;
    const notes = document.getElementById('input-notes').value.trim() || "Pakaian harian campur";
    const price = Math.round(weight * selectedPackageRate);
    const readyTime = document.getElementById('display-ready-time').textContent;

    try {
      const res = await fetch('/api/pesanan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          phone,
          packageCode: selectedPackageCode,
          packageName: selectedPackageName,
          weight,
          price,
          notes,
          paymentStatus: currentPaymentStatus,
          paymentMethod: currentPaymentMethod,
          readyTime
        })
      });
      const result = await res.json();
      if (result.data) {
        currentReceiptOrder = result.data;
        orderList.unshift(currentReceiptOrder);
      }
    } catch (err) {
      currentReceiptOrder = {
        id: '#ORD-' + (100 + orderList.length + 1),
        name,
        phone,
        packageName: selectedPackageName,
        weight,
        price,
        notes,
        readyTime,
        status: 'Diproses',
        paymentStatus: currentPaymentStatus,
        paymentMethod: currentPaymentMethod
      };
    }

    populateAndShowModal(currentReceiptOrder);
  }

  function previewSpecificReceipt(id) {
    const found = orderList.find(o => o.id === id);
    if (found) {
      populateStatusCucianTab(found);
      switchTab('status');
    }
  }

  function populateStatusCucianTab(order) {
    currentReceiptOrder = order;
    document.getElementById('detail-struk-id').textContent = 'Struk Transaksi Digital ' + order.id;
    document.getElementById('detail-struk-time').textContent = 'Waktu Masuk: ' + (order.created_at || 'Rabu, 4 Nov 2026 - 10:15 WIB');
    document.getElementById('detail-cust-name').textContent = order.name;
    document.getElementById('detail-cust-wa').textContent = order.phone;
    document.getElementById('detail-pkg-name').textContent = order.packageName || order.pkg || 'Cuci Reguler';
    document.getElementById('detail-weight').textContent = order.weight + ' Kg';
    document.getElementById('detail-notes').textContent = order.notes || '-';
    
    const payEl = document.getElementById('detail-pay-status');
    const payStat = (order.paymentStatus || 'Lunas').toUpperCase();
    const payMeth = (order.paymentMethod || 'QRIS').toUpperCase();
    payEl.textContent = `${payStat} ${payMeth}`;
    if (payStat.includes('LUNAS')) {
      payEl.className = "font-extrabold text-emerald-600 uppercase tracking-wide";
    } else {
      payEl.className = "font-extrabold text-amber-600 uppercase tracking-wide";
    }

    document.getElementById('detail-total-price').textContent = 'RP. ' + (order.price || 0).toLocaleString('id-ID');
    document.getElementById('detail-ready-time').textContent = order.readyTime || order.ready || 'Hari Ini';

    const waDraft = `Halo Kak ${order.name.toUpperCase()}! 👋
Terima kasih sudah mencuci di MyLaundry.

Berikut detail pesanan Anda:
📦 ID Order: ${order.id}
⚖️ Berat: ${order.weight} Kg (${order.packageName || order.pkg || 'Cuci Reguler'})
💰 Total: Rp ${(order.price || 0).toLocaleString('id-ID')} (${order.paymentStatus || 'Lunas'} - ${order.paymentMethod || 'QRIS'})
⏰ Estimasi Selesai: ${order.readyTime || order.ready || 'Hari Ini'}

Saat mengambil pakaian, cukup sebutkan ID Order ${order.id}.
Pesan ini dikirim otomatis oleh MyLaundry AI. Terima kasih! 🙏`;

    document.getElementById('detail-wa-draft').textContent = waDraft;
  }

  function openWhatsAppFromDetail() {
    const order = currentReceiptOrder || orderList[0];
    if (!order) return;
    const cleanPhone = order.phone.replace(/^0/, '62').replace(/\D/g, '');
    const draftText = document.getElementById('detail-wa-draft').textContent;
    window.open(`https://wa.me/${cleanPhone}?text=${encodeURIComponent(draftText)}`, '_blank');
  }

  function populateAndShowModal(order) {
    currentReceiptOrder = order;
    document.getElementById('receipt-id').textContent = order.id;
    document.getElementById('receipt-cust').textContent = order.name;
    document.getElementById('receipt-phone').textContent = order.phone;
    document.getElementById('receipt-pkg').textContent = `${order.packageName || order.pkg} (${order.weight} Kg)`;
    document.getElementById('receipt-notes').textContent = order.notes || "Pakaian harian campur";
    document.getElementById('receipt-total').textContent = "Rp " + order.price.toLocaleString('id-ID');
    document.getElementById('receipt-ready').textContent = order.readyTime || order.ready;
    document.getElementById('receipt-pay-status').textContent = `${order.paymentStatus || 'Lunas'} (${order.paymentMethod || 'Tunai'})`;

    const waText = 
`Halo Kak *${order.name}*! Terima kasih sudah mencuci di *MyLaundry Bantul* 🧺✨

Berikut rincian nota digital cucian Anda:
📌 No. Order: *${order.id}*
👕 Layanan: ${order.packageName || order.pkg} (${order.weight} Kg)
💵 Total Biaya: *Rp ${order.price.toLocaleString('id-ID')}* (${order.paymentStatus || 'Lunas'})
⏰ Perkiraan Siap Ambil: *${order.readyTime || order.ready}*

Pakaian sedang kami proses dengan higienis dan rapi. Kami akan mengabari kembali jika cucian sudah siap diambil ya Kak! 🙏😊`;

    document.getElementById('wa-text-preview').textContent = waText;

    const modal = document.getElementById('receipt-modal');
    const box = document.getElementById('modal-box');
    modal.classList.remove('hidden');
    setTimeout(() => {
      box.classList.remove('scale-95', 'opacity-0');
      box.classList.add('scale-100', 'opacity-100');
    }, 50);
  }

  function closeReceiptModal() {
    const modal = document.getElementById('receipt-modal');
    const box = document.getElementById('modal-box');
    box.classList.remove('scale-100', 'opacity-100');
    box.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function openWhatsAppURL() {
    if (!currentReceiptOrder) return;
    const cleanPhone = currentReceiptOrder.phone.replace(/^0/, '62').replace(/\D/g, '');
    const text = encodeURIComponent(document.getElementById('wa-text-preview').textContent);
    const url = `https://wa.me/${cleanPhone}?text=${text}`;
    window.open(url, '_blank');
  }

  // TOGGLE DRAWER CHATBOT AI
  function toggleAIDrawer() {
    const drawer = document.getElementById('ai-drawer');
    isDrawerOpen = !isDrawerOpen;
    if (isDrawerOpen) {
      drawer.classList.remove('translate-x-full');
    } else {
      drawer.classList.add('translate-x-full');
    }
  }

  function sendUserMessage() {
    const input = document.getElementById('ai-input');
    const text = input.value.trim();
    if (!text) return;

    appendChatMessage('user', text);
    input.value = '';

    setTimeout(() => {
      generateAIResponse(text);
    }, 400);
  }

  function handleAIEnter(e) {
    if (e.key === 'Enter') sendUserMessage();
  }

  function sendQuickPrompt(promptText) {
    if (!isDrawerOpen) toggleAIDrawer();
    appendChatMessage('user', promptText);
    setTimeout(() => {
      generateAIResponse(promptText);
    }, 400);
  }

  function askAIWeatherDraft() {
    if (!isDrawerOpen) toggleAIDrawer();
    sendQuickPrompt('Buatkan draf WhatsApp permohonan maaf keterlambatan cucian karena cuaca hujan lebat');
  }

  function appendChatMessage(sender, text) {
    const chatBox = document.getElementById('ai-chat-box');
    const div = document.createElement('div');
    div.className = "flex items-start space-x-2";

    if (sender === 'user') {
      div.innerHTML = `
        <div class="ml-auto bg-blue-600 text-white rounded-2xl p-3 max-w-[85%] text-xs font-bold shadow-xs">
          ${text}
        </div>
      `;
    } else {
      div.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-black flex-shrink-0 shadow-xs">✨</div>
        <div class="bg-white border border-slate-200 rounded-2xl p-3.5 text-slate-800 max-w-[85%] space-y-1 shadow-sm font-medium">
          ${text}
        </div>
      `;
    }
    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  function generateAIResponse(prompt) {
    const p = prompt.toLowerCase();
    let reply = "";

    if (p.includes('menumpuk') || p.includes('>3 hari')) {
      reply = `
        <p class="font-black text-slate-900">📌 Ringkasan Cucian Menumpuk &gt;3 Hari:</p>
        <p>Berdasarkan data toko, ada <strong>2 pesanan</strong> yang belum diambil:</p>
        <ul class="list-disc pl-4 space-y-1 text-slate-800 mt-1 font-mono text-[11px]">
          <li>#ORD-098: Mas Dimas (7.2 Kg, 4 hari lalu, Belum Lunas)</li>
          <li>#ORD-097: Pak Bambang (4.8 Kg, 5 hari lalu, Lunas)</li>
        </ul>
        <p class="mt-2 text-blue-800 font-bold">💡 Saran: Mau saya buatkan draf pengingat ramah untuk Mas Dimas?</p>
      `;
    } else if (p.includes('dimas')) {
      reply = `
        <p class="font-black text-slate-900">💬 Rekomendasi Draf Pesan ke Mas Dimas:</p>
        <div class="bg-slate-100 p-2.5 rounded-xl border border-slate-300 font-mono text-[11px] text-slate-900 whitespace-pre-line mt-1">
"Halo Mas Dimas! Semoga harinya lancar 😊 
Mau mengabari kalau cucian kemeja & jeans Mas (#ORD-098) sudah selesai dan tersimpan rapi di rak toko MyLaundry. 
Kira-kira sempat mampir ambil sore ini? Terima kasih banyak Mas! 🙏"
        </div>
        <p class="text-[10px] text-slate-500 mt-1 font-medium">Mbak Sarah tinggal salin dan kirim lewat WhatsApp.</p>
      `;
    } else if (p.includes('hujan') || p.includes('cuaca') || p.includes('lambat')) {
      reply = `
        <p class="font-black text-slate-900">🌧 Draf Pesan Keterlambatan Cuaca Hujan:</p>
        <div class="bg-slate-100 p-2.5 rounded-xl border border-slate-300 font-mono text-[11px] text-slate-900 whitespace-pre-line mt-1">
"Halo Kak! Kami dari MyLaundry ingin mengabarkan bahwa cuaca di Bantul saat ini sedang hujan lebat, sehingga proses pengeringan cucian Kakak sedikit terhambat demi memastikan pakaian benar-benar kering maksimal dan tidak apek. 
Perkiraan waktu siap ambil kami sesuaikan menjadi jam 18:00 WIB ya Kak. Mohon maaf atas ketidaknyamanannya dan terima kasih atas kesabarannya! 🙏🌧"
        </div>
      `;
    } else if (p.includes('beban') || p.includes('total kg') || p.includes('berat')) {
      reply = `
        <p class="font-black text-slate-900">⚖️ Analisis Beban Cucian Toko:</p>
        <p>Total cucian yang sedang diproses di toko adalah <strong><%= stats.diprosesKg %> Kg</strong> (<%= stats.diprosesCount %> antrean aktif). Toko beroperasi pada kapasitas normal.</p>
      `;
    } else {
      reply = `
        <p class="font-black text-slate-900">Informasi Ditemukan:</p>
        <p>Perintah dipahami. Database mencatat seluruh pesanan aktif dan antrean toko dalam kondisi lancar. Apakah ada data pelanggan tertentu yang ingin dicek, Mbak Sarah?</p>
      `;
    }

    appendChatMessage('bot', reply);
  }

  // UJI REST API DI TAB 3 (SUITE CRUD WEEK 8)
  async function testApiEndpoint(endpoint, containerId) {
    const container = document.getElementById(containerId);
    container.textContent = 'Mengirim request ke ' + endpoint + '...';
    try {
      const response = await fetch(endpoint);
      const data = await response.json();
      container.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      container.textContent = 'Gagal memuat API: ' + err.message;
    }
  }

  async function testApiPost() {
    const container = document.getElementById('response-post');
    container.textContent = 'Mengirim POST request ke /api/produk...';
    try {
      const payload = {
        nama: 'Cuci Helm & Aksesoris ' + Math.floor(Math.random() * 100),
        kategori: 'Treatment',
        harga: 25000,
        satuan: 'pcs',
        estimasi_jam: 24,
        durasi_label: '1 Hari (24 Jam)',
        icon: '🪖',
        deskripsi: 'Pembersihan helm deep clean anti bakteri dan pewangi segar.'
      };
      const res = await fetch('/api/produk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      container.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      container.textContent = 'Error: ' + err.message;
    }
  }

  async function testApiPut() {
    const id = document.getElementById('test-put-id').value;
    const container = document.getElementById('response-put');
    container.textContent = 'Mengirim PUT request ke /api/produk/' + id + '...';
    try {
      const payload = {
        harga: 7500 + Math.floor(Math.random() * 1000),
        badge: 'Harga Update ' + new Date().toLocaleTimeString('id-ID')
      };
      const res = await fetch('/api/produk/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      container.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      container.textContent = 'Error: ' + err.message;
    }
  }

  async function testApiDelete() {
    const id = document.getElementById('test-del-id').value;
    const container = document.getElementById('response-delete');
    if (!id) {
      container.textContent = 'Silakan isi ID produk terlebih dahulu.';
      return;
    }
    container.textContent = 'Mengirim DELETE request ke /api/produk/' + id + '...';
    try {
      const res = await fetch('/api/produk/' + id, { method: 'DELETE' });
      const data = await res.json();
      container.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      container.textContent = 'Error: ' + err.message;
    }
  }

  function showFeatureAlert(msg) {
    alert(msg);
  }

  window.addEventListener('DOMContentLoaded', () => {
    calculateTotal();
  });
</script>