  async function handleTabChatSubmit(e) {
    if (e && e.preventDefault) e.preventDefault();

    const input = document.getElementById('tab-chat-input');
    const loading = document.getElementById('tab-chat-loading');
    const sendBtn = document.getElementById('tab-chat-send-btn');
    const userText = input.value.trim();

    if (!userText) {
      // Feedback visual jika input kosong atau hanya spasi
      input.classList.add('border-rose-500', 'ring-2', 'ring-rose-400/40');
      setTimeout(() => {
        input.classList.remove('border-rose-500', 'ring-2', 'ring-rose-400/40');
      }, 1500);

      appendTabChatMessage('bot', '⚠️ Pesan pertanyaan tidak boleh kosong atau hanya berupa spasi. Silakan ketik pertanyaan seputar layanan MyLaundry.', true);
      input.focus();
      return;
    }

    // Tampilkan pesan pengguna di bubble chat
    appendTabChatMessage('user', userText);
    input.value = '';
    updateCharCount('');

    // Set UI ke mode Loading
    loading.classList.remove('hidden');
    sendBtn.disabled = true;
    sendBtn.classList.add('opacity-50', 'cursor-not-allowed');

    try {
      // Panggil endpoint backend Express.js
      const result = await requestAIChat(userText);

      if (result.ok && result.data && result.data.success) {
        const replyText = result.data.data?.reply || 'Tidak ada balasan dari AI.';
        appendTabChatMessage('bot', replyText);
      } else {
        // Tangani pesan error / guardrail rejection dari backend
        const errMsg = result.data?.data?.reply || result.data?.message || 'Gagal menerima respon dari layanan AI.';
        appendTabChatMessage('bot', errMsg, true);
      }
    } catch (netErr) {
      appendTabChatMessage('bot', `Terjadi kesalahan koneksi ke server: ${netErr.message}. Pastikan backend Express.js berjalan.`, true);
    } finally {
      loading.classList.add('hidden');
      sendBtn.disabled = false;
      sendBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      input.focus();
    }
  }

