  async function submitTambahPelanggan() {
    const name = document.getElementById('cust-add-name').value.trim();
    const rawPhone = document.getElementById('cust-add-phone').value.trim();
    const cleanPhone = rawPhone.replace(/[^0-9]/g, '');
    const note = document.getElementById('cust-add-note').value.trim();
    const msg = document.getElementById('msg-tambah-cust');

    if (!name || name.length < 2) {
      msg.textContent = '⚠️ Nama pelanggan wajib diisi minimal 2 karakter.';
      msg.className = 'text-xs font-bold text-rose-600';
      msg.classList.remove('hidden');
      return;
    }

    if (!cleanPhone || cleanPhone.length < 10 || cleanPhone.length > 15) {
      msg.textContent = '⚠️ Nomor WhatsApp harus 10-15 digit angka (contoh: 081234567890).';
      msg.className = 'text-xs font-bold text-rose-600';
      msg.classList.remove('hidden');
      return;
    }

    const phone = cleanPhone.startsWith('62') ? '0' + cleanPhone.slice(2) : (cleanPhone.startsWith('0') ? cleanPhone : '0' + cleanPhone);

    try {
      const res = await fetch('/api/pelanggan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, phone, note })
      });
      const data = await res.json();
      if (res.ok) {
