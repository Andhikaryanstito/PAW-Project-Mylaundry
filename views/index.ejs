<!-- CLIENT-SIDE JAVASCRIPT & STATE MANAGEMENT -->
<script>
  // Inisialisasi data dari backend controller EJS
  const backendProducts = <%- JSON.stringify(products) %>;
  const backendCustomers = <%- JSON.stringify(customers) %>;
  let orderList = <%- JSON.stringify(orders) %>;
  
  let currentFilter = 'all';
  let isRaining = false;
  let selectedPackageRate = backendProducts[0]?.harga || 7000;
  let selectedPackageHours = backendProducts[0]?.estimasi_jam || 48;
  let selectedPackageName = backendProducts[0]?.nama || 'Cuci Reguler';
  let selectedPackageCode = backendProducts[0]?.kode || 'reguler';
  let currentPaymentStatus = 'Lunas';
  let currentPaymentMethod = 'Tunai';
  let currentReceiptOrder = null;
  let isDrawerOpen = false;

  // TAB SWITCHER (FRESH ECO-CLEAN THEME)
  function switchTab(tabId) {
    const allTabs = ['dashboard', 'transaksi', 'api-tester', 'status', 'ai-assistant', 'pelanggan', 'pengaturan'];
    allTabs.forEach(id => {
      const el = document.getElementById('tab-' + id);
      if (el) el.classList.add('hidden');
    });

    document.querySelectorAll('.nav-tab').forEach(el => {
      el.classList.remove('bg-teal-800', 'text-white', 'shadow-xs', 'bg-blue-600');
      el.classList.add('text-stone-700', 'hover:text-teal-900', 'hover:bg-stone-100');
    });

    const targetTab = document.getElementById('tab-' + tabId);
    if (targetTab) targetTab.classList.remove('hidden');

    const activeNav = document.getElementById('nav-' + tabId);
    if (activeNav) {
      activeNav.classList.remove('text-stone-700', 'hover:text-teal-900', 'hover:bg-stone-100');
      activeNav.classList.add('bg-teal-800', 'text-white', 'shadow-xs');
    }

    // Jika buka tab status cucian, otomatis muat data pesanan aktif
    if (tabId === 'status') {
      const orderToShow = currentReceiptOrder || orderList[0];
      if (orderToShow) {
        populateStatusCucianTab(orderToShow);
      }
    }
  }

  // CRM CUSTOMER TABLE FILTER
  function filterCustomerTable(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.cust-row');
    let count = 0;
    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const phone = row.getAttribute('data-phone') || '';
      const notes = row.getAttribute('data-notes') || '';
      if (name.includes(q) || phone.includes(q) || notes.includes(q)) {
        row.style.display = '';
        count++;
      } else {
        row.style.display = 'none';
      }
    });
    const badge = document.getElementById('crm-total-badge');
    if (badge) badge.textContent = `${count} Pelanggan`;
  }

  // DIRECT WHATSAPP CRM
  function directWhatsAppCustomer(phone, name) {
    const cleanPhone = (phone || '').replace(/^0/, '62').replace(/\D/g, '');
    const message = `Halo Kak ${name}! Terima kasih sudah menjadi pelanggan setia MyLaundry Bantul. Ada yang bisa kami bantu seputar cucian Anda hari ini? 😊`;
    window.open(`https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`, '_blank');
  }

  // AUTOFILL ORDER DARI CRM
  function autofillOrderForCustomer(name, phone) {
    switchTab('transaksi');
    document.getElementById('cust-name').value = name;
    document.getElementById('cust-wa').value = (phone || '').replace(/^0/, '').replace(/^\+62/, '');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // GLOBAL TOP SEARCH
  function handleGlobalSearch(val) {
    switchTab('dashboard');
    const query = val.toLowerCase().trim();
    const rows = document.querySelectorAll('.order-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const name = row.getAttribute('data-name');
      const id = row.getAttribute('data-id');
      if (name.includes(query) || id.includes(query)) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('visible-count').textContent = visibleCount;
  }

  // AUTOCOMPLETE PELANGGAN (PRD US-02)
  function handleCustomerAutocomplete(val) {
    const box = document.getElementById('autocomplete-box');
    if (!val || val.trim().length === 0) {
      box.classList.add('hidden');
      return;
    }
    const matches = backendCustomers.filter(c => c.name.toLowerCase().includes(val.toLowerCase()));
    if (matches.length === 0) {
      box.classList.add('hidden');
      return;
    }

    box.innerHTML = '';
    matches.forEach(c => {
      const item = document.createElement('div');
      item.className = "p-2.5 hover:bg-teal-50 cursor-pointer flex justify-between items-center transition";
      item.innerHTML = `
        <div>
          <p class="font-extrabold text-stone-900">${c.name}</p>
          <p class="text-[10px] text-stone-600 font-mono">${c.phone} ${c.note || ''}</p>
        </div>
        <span class="text-[10px] bg-teal-100 text-teal-800 font-black px-2 py-0.5 rounded">Pilih</span>
      `;
      item.onclick = function() {
        document.getElementById('cust-name').value = c.name;
        document.getElementById('cust-wa').value = c.phone.replace(/^0/, '');
        box.classList.add('hidden');
      };
      box.appendChild(item);
    });
    box.classList.remove('hidden');
  }

  // PILIH PAKET
  function selectPackage(kode, rate, hours, name) {
    selectedPackageCode = kode;
    selectedPackageRate = rate;
    selectedPackageHours = hours;
    selectedPackageName = name;

    document.querySelectorAll('.pkg-card').forEach(el => {
      el.className = "pkg-card cursor-pointer rounded-2xl p-4 border-2 border-stone-200 bg-white hover:border-teal-500 text-left transition relative";
    });

    const active = document.getElementById('pkg-' + kode);
    if (active) {
      active.className = "pkg-card cursor-pointer rounded-2xl p-4 border-2 border-teal-700 bg-teal-50/80 shadow-2xs text-left transition relative";
    }
    calculateTotal();
  }

  // TIMBANGAN BERAT
  function stepWeight(delta) {
    const input = document.getElementById('input-weight');
    let val = parseFloat(input.value) || 0;
    val = Math.max(0.5, Math.round((val + delta) * 10) / 10);
    input.value = val;
    calculateTotal();
  }

  function setWeight(val) {
    document.getElementById('input-weight').value = val;
    calculateTotal();
  }

  // STATUS & METODE BAYAR
  function setPaymentStatus(status) {
    currentPaymentStatus = status;
    if (status === 'Lunas') {
      document.getElementById('btn-status-lunas').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-teal-700 bg-teal-100 text-teal-900 transition";
      document.getElementById('btn-status-belum').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-stone-300 bg-white text-stone-600 transition hover:border-stone-400";
    } else {
      document.getElementById('btn-status-belum').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-amber-600 bg-amber-100 text-amber-900 transition";
      document.getElementById('btn-status-lunas').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-stone-300 bg-white text-stone-600 transition hover:border-stone-400";
    }
  }

  function setPaymentMethod(method) {
    currentPaymentMethod = method;
    if (method === 'Tunai') {
      document.getElementById('btn-method-tunai').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-teal-700 bg-teal-100 text-teal-900 transition";
      document.getElementById('btn-method-qris').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-stone-300 bg-white text-stone-600 transition hover:border-stone-400";
    } else {
      document.getElementById('btn-method-qris').className = "px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-teal-700 bg-teal-100 text-teal-900 transition";
      document.getElementById('btn-method-tunai').className = "px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-stone-300 bg-white text-stone-600 transition hover:border-stone-400";
    }
  }

  // KALKULASI HARGA & JAM SELESAI
  function calculateTotal() {
    const weight = parseFloat(document.getElementById('input-weight').value) || 0;
    const total = Math.round(weight * selectedPackageRate);
    document.getElementById('display-total-price').textContent = total.toLocaleString('id-ID');
    document.getElementById('display-calc-detail').textContent = `${weight} Kg × Rp ${selectedPackageRate.toLocaleString('id-ID')} (${selectedPackageName})`;

    const now = new Date();
    let readyDate = new Date(now.getTime() + (selectedPackageHours * 60 * 60 * 1000));
    if (isRaining) {
      readyDate = new Date(readyDate.getTime() + (3 * 60 * 60 * 1000));
      document.getElementById('weather-buffer-note').textContent = '⚠️ Ditambah buffer +3 jam (hujan)';
      document.getElementById('weather-buffer-note').className = 'text-[10px] text-amber-900 font-black';
    } else {
      document.getElementById('weather-buffer-note').textContent = 'Buffer cuaca normal';
      document.getElementById('weather-buffer-note').className = 'text-[10px] text-slate-600 font-semibold';
    }

    const options = { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' };
    const formatted = readyDate.toLocaleDateString('id-ID', options) + ' WIB';
