    const cleanPhone = (phone || '').replace(/^0/, '62').replace(/\D/g, '');
    const message = `Halo Kak ${name}! Terima kasih sudah menjadi pelanggan setia MyLaundry Bantul. Ada yang bisa kami bantu seputar cucian Anda hari ini? 😊`;
