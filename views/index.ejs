          <div class="w-12 h-12 rounded-2xl bg-teal-800 text-white flex items-center justify-center font-bold text-base shadow-sm" id="disp-kasir-avatar">
            <%= (currentUser && currentUser.avatar) ? currentUser.avatar : 'SA' %>
          </div>
          <div>
            <h4 class="font-extrabold text-sm text-slate-800" id="disp-kasir-name">
              <%= (currentUser && currentUser.name) ? currentUser.name : 'Sarah Anggraini' %>
            </h4>
            <p class="text-xs text-teal-800 font-bold" id="disp-kasir-role">
              <%= (currentUser && currentUser.role) ? currentUser.role : 'Kasir & Pemilik Toko' %> — <span id="disp-kasir-branch"><%= (currentUser && currentUser.branch) ? currentUser.branch : 'Cabang Bantul' %></span>
            </p>
            <p class="text-[11px] text-slate-500 mt-0.5" id="disp-kasir-email">
              Username: <%= (currentUser && currentUser.username) ? currentUser.username : 'sarah' %> &nbsp;|&nbsp; <%= (currentUser && currentUser.email) ? currentUser.email : 'sarah@mylaundry.com' %>
            </p>
          </div>
          <span class="ml-auto px-3 py-1 rounded-full text-[10px] font-black bg-teal-100 text-teal-900 border border-teal-300">Aktif</span>
        </div>
      </div>


      <!-- KELOLA PAKET LAYANAN (CRUD PRODUK) -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 space-y-4">
