  function bukaModalPelunasanDariCurrentOrder() {
    if (!currentReceiptOrder) {
      showToast('Pilih pesanan terlebih dahulu dari antrean.', 'warning');
      return;
    }
    bukaModalPelunasan(
      currentReceiptOrder.id,
      currentReceiptOrder.name,
      currentReceiptOrder.price,
      currentReceiptOrder.paymentStatus,
      currentReceiptOrder.paymentMethod
    );
  }

  function tutupModalPelunasan() {
    document.getElementById('modal-pelunasan').classList.add('hidden');
    activePelunasanOrder = null;
  }

  async function submitUpdatePembayaran(paymentStatus, paymentMethod) {
    if (!activePelunasanOrder) return;
    const { id } = activePelunasanOrder;

    try {
      const res = await fetch(`/api/pesanan/${encodeURIComponent(id)}/pembayaran`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paymentStatus, paymentMethod })
      });
      const result = await res.json();

      if (!res.ok) {
        showToast('Gagal update: ' + (result.message || 'Terjadi kesalahan.'), 'error');
        return;
      }

      // Update in orderList cache
      const order = orderList.find(o => o.id === id);
      if (order) {
        order.paymentStatus = paymentStatus;
        order.paymentMethod = paymentMethod;
      }

      // Update currentReceiptOrder jika sedang aktif
      if (currentReceiptOrder && currentReceiptOrder.id === id) {
        currentReceiptOrder.paymentStatus = paymentStatus;
        currentReceiptOrder.paymentMethod = paymentMethod;
        populateStatusCucianTab(currentReceiptOrder);
      }

      // Update cell in table DOM jika ada
      const cellId = 'pay-cell-' + id.replace('#', '');
      const cell = document.getElementById(cellId);
      if (cell) {
        if (paymentStatus === 'Lunas') {
          cell.innerHTML = `
            <button type="button" 
                    onclick="bukaModalPelunasan('${id}', \`${(order?.name || '').replace(/`/g, '\\`')}\`, ${order?.price || 0}, 'Lunas', '${paymentMethod}')" 
                    title="Klik untuk ubah metode pembayaran" 
                    class="badge-paid px-3 py-1 rounded-full text-[11px] font-extrabold shadow-2xs hover:scale-105 hover:shadow-sm transition cursor-pointer inline-flex items-center space-x-1.5 group">
              <span>✓ Lunas (${paymentMethod})</span>
              <span class="text-[9px] text-emerald-700 opacity-60 group-hover:opacity-100">✏️</span>
            </button>
          `;
        } else {
          cell.innerHTML = `
            <button type="button" 
                    onclick="bukaModalPelunasan('${id}', \`${(order?.name || '').replace(/`/g, '\\`')}\`, ${order?.price || 0}, 'Belum Lunas', '-')" 
                    title="Klik untuk proses pelunasan pesanan" 
                    class="badge-unpaid px-3 py-1 rounded-full text-[11px] font-extrabold shadow-2xs hover:scale-105 hover:ring-2 hover:ring-amber-400 transition cursor-pointer inline-flex items-center space-x-1.5 group">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
              <span>Belum Lunas</span>
              <span class="text-[9px] bg-amber-200 text-amber-950 px-1.5 py-0.5 rounded font-black uppercase tracking-wider group-hover:bg-amber-300">Bayar ➔</span>
            </button>
          `;
        }
      }

      tutupModalPelunasan();
      showToast(`Status pembayaran ${id} berhasil diubah jadi ${paymentStatus}${paymentStatus === 'Lunas' ? ' (' + paymentMethod + ')' : ''}!`, 'success');

    } catch (err) {
      showToast('Error koneksi: ' + err.message, 'error');
    }
  }

  // SIMPAN TRANSAKSI & BUKA NOTA (STRICT VALIDATION)
  async function submitTransaction() {
    const errorBanner = document.getElementById('transaksi-error-banner');
    const errorText = document.getElementById('transaksi-error-text');
    if (errorBanner) errorBanner.classList.add('hidden');

    const nameInput = document.getElementById('cust-name');
    const waInput = document.getElementById('cust-wa');
    const weightInput = document.getElementById('input-weight');

    const name = nameInput.value.trim();
    if (!name || name.length < 2) {
      if (errorBanner && errorText) {
        errorText.textContent = 'Nama pelanggan wajib diisi (minimal 2 karakter).';
        errorBanner.classList.remove('hidden');
      }
      nameInput.focus();
      return;
    }

    const rawWa = waInput.value.trim();
    const cleanWa = rawWa.replace(/[^0-9]/g, '');
    if (!cleanWa || cleanWa.length < 10 || cleanWa.length > 15) {
      if (errorBanner && errorText) {
        errorText.textContent = 'Nomor WhatsApp tidak valid. Masukkan 10-15 digit angka (contoh: 081234567890).';
        errorBanner.classList.remove('hidden');
      }
      waInput.focus();
      return;
    }

    const phone = cleanWa.startsWith('62') 
      ? '0' + cleanWa.slice(2) 
      : (cleanWa.startsWith('0') ? cleanWa : '0' + cleanWa);

    const weight = parseFloat(weightInput.value);
    if (isNaN(weight) || weight <= 0 || weight > 200) {
      if (errorBanner && errorText) {
        errorText.textContent = 'Berat pakaian harus berupa angka positif antara 0.1 - 200 Kg.';
        errorBanner.classList.remove('hidden');
      }
      weightInput.focus();
      return;
    }

    const notes = document.getElementById('input-notes').value.trim() || "Pakaian harian campur";
    const price = Math.round(weight * selectedPackageRate);
    const readyTime = document.getElementById('display-ready-time').textContent;

    try {
      const res = await fetch('/api/pesanan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          phone,
          packageCode: selectedPackageCode,
          packageName: selectedPackageName,
          weight,
          price,
          notes,
          paymentStatus: currentPaymentStatus,
          paymentMethod: currentPaymentMethod,
          readyTime
        })
      });
      const result = await res.json();
      if (!res.ok) {
        if (errorBanner && errorText) {
          errorText.textContent = result.message || 'Gagal menyimpan transaksi kasir.';
          errorBanner.classList.remove('hidden');
        } else {
          showToast('Gagal menyimpan: ' + (result.message || 'Terjadi kesalahan.'), 'error');
        }
        return;
      }

      if (result.data) {
        currentReceiptOrder = result.data;
        orderList.unshift(currentReceiptOrder);
        isNewTransactionCreated = true;
        prependOrderToAntreanDom(currentReceiptOrder);

        // Jika pelanggan baru otomatis terdaftar, masukkan ke tabel CRM
        if (result.customer) {
          appendCustomerToCrmDom(result.customer);
        }

        // Reset formulir kasir
        nameInput.value = '';
        waInput.value = '';
        document.getElementById('input-notes').value = '';
        weightInput.value = '3.0';
        calculateTotal();
      }
      populateAndShowModal(currentReceiptOrder);
    } catch (err) {
      if (errorBanner && errorText) {
        errorText.textContent = 'Koneksi bermasalah: ' + err.message;
        errorBanner.classList.remove('hidden');
      } else {
        showToast('Error koneksi: ' + err.message, 'error');
      }
    }
  }

