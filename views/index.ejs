            <h3 class="text-2xl font-black text-slate-900 mt-1"><%= customers.length %> Orang</h3>
            <p class="text-[11px] text-teal-700 font-medium mt-0.5">Tersimpan di Database</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center text-xl font-bold">
            👥
          </div>
