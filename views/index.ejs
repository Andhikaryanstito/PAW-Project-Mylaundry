        </div>
        <div class="flex items-center gap-2 pt-1">
          <button onclick="submitTambahPelanggan()" class="px-4 py-2 bg-gradient-to-r from-teal-700 to-emerald-700 hover:from-teal-800 hover:to-emerald-800 text-white text-xs font-bold rounded-lg transition shadow-xs cursor-pointer">Simpan Pelanggan</button>
