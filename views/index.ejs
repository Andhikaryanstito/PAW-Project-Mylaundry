<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- WRAPPER KONTEN UTAMA (DI SEBELAH KANAN SIDEBAR - FRESH ECO-CLEAN THEME) -->
<div class="flex-1 flex flex-col min-h-screen overflow-x-hidden bg-slate-50/80 font-sans">

  <!-- TOP HEADER BAR (PENCARIAN CEPAT & STATUS CUACA TOKO) -->
  <header class="sticky top-0 z-20 bg-white/95 backdrop-blur-md border-b border-slate-200/90 px-6 sm:px-8 py-3.5 flex items-center justify-between gap-4 shadow-xs">
    
    <!-- Search Bar Global / Cepat -->
    <div class="relative flex-1 max-w-lg">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <input type="text" id="top-search" oninput="handleGlobalSearch(this.value)" placeholder="Cari nama pelanggan, nomor WhatsApp, atau ID order..." class="w-full pl-10 pr-4 py-2 text-xs rounded-xl bg-slate-100 hover:bg-slate-200/60 focus:bg-white border border-slate-200 focus:border-teal-600 focus:ring-2 focus:ring-teal-500/15 text-slate-900 placeholder-slate-400 transition font-medium">
    </div>

    <!-- Right Header Actions: Simulasi Cuaca & Tanggal -->
    <div class="flex items-center space-x-3 flex-shrink-0">
      
      <!-- Weather Simulation Button -->
      <button onclick="toggleWeather()" id="weather-btn" class="px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center space-x-2 bg-amber-50 text-amber-900 border border-amber-300 hover:bg-amber-100 transition shadow-2xs cursor-pointer" title="Klik untuk simulasi cuaca hujan/cerah">
        <span id="weather-icon">☀️</span>
        <span id="weather-text" class="hidden sm:inline">Cerah (31°C)</span>
        <span class="text-[9px] bg-amber-200/80 text-amber-950 px-1.5 py-0.5 rounded-full font-black uppercase tracking-wider">Simulasi</span>
      </button>

      <!-- Tanggal Operasional Shift -->
      <div class="hidden md:flex items-center space-x-2 text-xs text-slate-600 pl-3 border-l border-slate-200 font-semibold">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span><%= formatDateTime(new Date()).split(',')[0] %></span>
      </div>

    </div>
  </header>

  <!-- WEATHER ALERT BANNER (PRD US-06) -->
  <%- include('partials/weatherBanner') %>

  <!-- MAIN VIEWPORT CONTAINER -->
  <main class="p-6 md:p-8 space-y-6 flex-1">

    <!-- ======================================================== -->
    <!-- TAB 1: DASHBOARD PEMANTAUAN ANTREAN (PRD F-04 & FIGMA)   -->
    <!-- ======================================================== -->
    <div id="tab-dashboard" class="space-y-6">
      
      <!-- 4 HERO STATS CARDS (FRESH ECO-LUXE THEME) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Stat 1: Total Antrean Aktif -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-card card-lift flex flex-col justify-between relative overflow-hidden group">
          <div class="h-1.5 bg-gradient-to-r from-teal-500 via-teal-600 to-emerald-500 -mt-5 -mx-5 mb-4 rounded-t-2xl"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-slate-500 uppercase tracking-wider">Antrean Aktif</span>
            <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-600 text-white ring-1 ring-teal-600/20 shadow-sm flex items-center justify-center font-bold text-lg group-hover:scale-105 transition">
              🧺
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-total-order"><%= stats.totalOrder %></h2>
              <span class="text-[10px] font-black text-teal-800 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-200/80">Hari Ini</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">
              Beban toko: <strong class="text-slate-900 font-bold tabular-nums" id="stat-total-kg"><%= stats.totalKg %> Kg</strong> pakaian
            </p>
          </div>
        </div>

        <!-- Stat 2: Sedang Diproses -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-card card-lift flex flex-col justify-between relative overflow-hidden group">
          <div class="h-1.5 bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 -mt-5 -mx-5 mb-4 rounded-t-2xl"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-amber-800 uppercase tracking-wider">Sedang Diproses</span>
            <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 text-white ring-1 ring-amber-600/20 shadow-sm flex items-center justify-center font-bold text-lg group-hover:scale-105 transition">
              ⏳
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-diproses"><%= stats.diprosesCount %></h2>
              <span class="text-[10px] font-black text-amber-900 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200/80">Cuci &amp; Setrika</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">
              <strong class="text-slate-900 font-bold tabular-nums"><%= stats.diprosesKg %> Kg</strong> dalam pengerjaan
            </p>
          </div>
        </div>

        <!-- Stat 3: Siap Diambil -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-card card-lift flex flex-col justify-between relative overflow-hidden group">
          <div class="h-1.5 bg-gradient-to-r from-emerald-400 via-emerald-500 to-green-500 -mt-5 -mx-5 mb-4 rounded-t-2xl"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-emerald-800 uppercase tracking-wider">Siap Diambil</span>
            <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 text-white ring-1 ring-emerald-600/20 shadow-sm flex items-center justify-center font-bold text-lg group-hover:scale-105 transition">
              ✓
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-siap"><%= stats.siapCount %></h2>
              <span class="text-[10px] font-black text-emerald-900 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/80">Di Rak Toko</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">Siap diserahkan ke pelanggan</p>
          </div>
        </div>

        <!-- Stat 4: Menumpuk >3 Hari -->
        <div class="bg-white rounded-2xl p-5 border border-rose-200/80 shadow-card card-lift flex flex-col justify-between relative overflow-hidden group">
          <div class="h-1.5 bg-gradient-to-r from-rose-500 via-rose-600 to-red-600 -mt-5 -mx-5 mb-4 rounded-t-2xl"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-rose-700 uppercase tracking-wider">Menumpuk &gt;3 Hari</span>
            <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-red-600 text-white ring-1 ring-rose-600/20 shadow-sm flex items-center justify-center font-bold text-lg group-hover:scale-105 transition">
              ⚠️
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-rose-700 tracking-tight tabular-nums" id="stat-menumpuk"><%= stats.menumpukCount %></h2>
              <span class="text-[10px] font-black text-rose-900 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200/80">Perlu Diingatkan</span>
            </div>
            <p class="text-xs text-rose-700 mt-1.5 font-semibold">Menghambat rak penyimpanan</p>
          </div>
        </div>

      </div>

      <!-- TABEL ANTREAN UTAMA: FRESH ECO-CLEAN -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">

        <!-- Table Toolbar dengan gradient header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 bg-gradient-to-r from-slate-50 to-teal-50/40 border-b border-slate-200">
          <div>
            <div class="flex items-center space-x-2.5">
              <h3 class="text-base font-black text-slate-900 tracking-tight">Daftar Antrean Cucian Toko</h3>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-teal-100 text-teal-800 border border-teal-300" id="visible-count">
                <%= orders.length %>
              </span>
            </div>
            <p class="text-xs text-slate-500 font-medium mt-0.5">
              Urutan antrean pengerjaan cucian terurut berdasarkan estimasi siap ambil.
            </p>
          </div>

          <div class="flex items-center space-x-3 w-full sm:w-auto">
            <!-- Filter Tabs -->
            <div class="flex items-center p-1 bg-slate-100 rounded-xl space-x-1 text-xs font-bold text-slate-700 border border-slate-200">
              <button onclick="setFilter('all')" id="filter-all" class="filter-btn px-3 py-1.5 rounded-lg bg-teal-800 text-white shadow-2xs transition">
                Semua (<%= orders.length %>)
              </button>
              <button onclick="setFilter('Diproses')" id="filter-diproses" class="filter-btn px-3 py-1.5 rounded-lg hover:text-teal-900 hover:bg-slate-200 transition">
                Diproses (<%= stats.diprosesCount %>)
              </button>
              <button onclick="setFilter('Siap Diambil')" id="filter-siapdiambil" class="filter-btn px-3 py-1.5 rounded-lg hover:text-teal-900 hover:bg-slate-200 transition">
                Siap (<%= stats.siapCount %>)
              </button>
              <button onclick="setFilter('Menumpuk')" id="filter-menumpuk" class="filter-btn px-3 py-1.5 rounded-lg text-rose-700 hover:bg-rose-100 transition">
                Menumpuk (<%= stats.menumpukCount %>)
              </button>
            </div>

            <!-- Tombol Tambah Order Baru -->
            <button onclick="switchTab('transaksi')" class="px-4 py-2 bg-teal-800 hover:bg-teal-900 text-white rounded-xl text-xs font-extrabold transition flex items-center space-x-1.5 shadow-xs flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
              <span>+ Order Baru</span>
            </button>
          </div>
        </div>

        <!-- Tabel Responsif & Lega -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="orders-table">
            <thead>
              <tr class="text-[11px] font-black text-teal-50 uppercase tracking-wider bg-gradient-to-r from-teal-800 to-teal-700">
                <th class="py-3.5 px-4">Order ID</th>
                <th class="py-3.5 px-4">Pelanggan</th>
                <th class="py-3.5 px-4">Paket &amp; Berat</th>
                <th class="py-3.5 px-4">Estimasi Siap</th>
                <th class="py-3.5 px-4">Status Cucian</th>
                <th class="py-3.5 px-4">Status Bayar</th>
                <th class="py-3.5 px-4 text-center">Aksi Cepat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-xs" id="orders-table-body">
              <% orders.forEach(order => { %>
                <tr class="order-row hover:bg-slate-100/60 transition group" 
                    data-status="<%= order.status %>" 
                    data-name="<%= (order.name || '').toLowerCase() %>" 
                    data-id="<%= (order.id || '').toLowerCase() %>">
                  
                  <!-- Kolom 1: Order ID -->
                  <td class="py-3.5 px-4 font-mono font-extrabold text-teal-800 whitespace-nowrap">
                    <%= order.id %>
                  </td>

                  <!-- Kolom 2: Pelanggan (Dual-Line: Nama + Phone) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <p class="font-extrabold text-slate-900 leading-snug"><%= order.name %></p>
                    <p class="text-[11px] font-mono text-slate-500 font-semibold mt-0.5"><%= order.phone %></p>
                  </td>

                  <!-- Kolom 3: Paket & Berat (Dual-Line) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <p class="font-extrabold text-slate-900 leading-snug"><%= order.packageName %></p>
                    <p class="text-[11px] text-slate-600 mt-0.5">
                      <span class="font-bold text-slate-800"><%= order.weight %> Kg</span> • 
                      <span class="font-mono text-teal-800 font-black"><%= formatCurrency(order.price) %></span>
                    </p>
                  </td>

                  <!-- Kolom 4: Estimasi Siap -->
                  <td class="py-3.5 px-4 whitespace-nowrap text-slate-700 font-semibold">
                    <%= order.readyTime %>
                  </td>

                  <!-- Kolom 5: Status Pakaian (Pill Badge Kontras) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <% if (order.status === 'Diproses') { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-processing px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>Diproses</span>
                      </button>
                    <% } else if (order.status === 'Siap Diambil') { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-ready px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span>✓</span>
                        <span>Siap Diambil</span>
                      </button>
                    <% } else { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-overdue px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span>⚠️</span>
                        <span>&gt;3 Hari di Rak</span>
                      </button>
                    <% } %>
                  </td>

                  <!-- Kolom 6: Status Bayar (Interaktif - Klik untuk Pelunasan) -->
                  <td class="py-3.5 px-4 whitespace-nowrap" id="pay-cell-<%= order.id.replace('#', '') %>">
                    <% if (order.paymentStatus === 'Lunas') { %>
                      <button type="button" 
                              onclick="bukaModalPelunasan('<%= order.id %>', `<%= (order.name || '').replace(/`/g, '\\`') %>`, <%= order.price || 0 %>, '<%= order.paymentStatus %>', '<%= order.paymentMethod || 'Tunai' %>')" 
                              title="Klik untuk ubah metode pembayaran" 
                              class="badge-paid px-3 py-1 rounded-full text-[11px] font-extrabold shadow-2xs hover:scale-105 hover:shadow-sm transition cursor-pointer inline-flex items-center space-x-1.5 group">
                        <span>✓ Lunas (<%= order.paymentMethod %>)</span>
                        <span class="text-[9px] text-emerald-700 opacity-60 group-hover:opacity-100">✏️</span>
                      </button>
                    <% } else { %>
                      <button type="button" 
                              onclick="bukaModalPelunasan('<%= order.id %>', `<%= (order.name || '').replace(/`/g, '\\`') %>`, <%= order.price || 0 %>, '<%= order.paymentStatus %>', '<%= order.paymentMethod || '-' %>')" 
                              title="Klik untuk proses pelunasan pesanan" 
                              class="badge-unpaid px-3 py-1 rounded-full text-[11px] font-extrabold shadow-2xs hover:scale-105 hover:ring-2 hover:ring-amber-400 transition cursor-pointer inline-flex items-center space-x-1.5 group">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>Belum Lunas</span>
                        <span class="text-[9px] bg-amber-200 text-amber-950 px-1.5 py-0.5 rounded font-black uppercase tracking-wider group-hover:bg-amber-300">Bayar ➔</span>
                      </button>
                    <% } %>
                  </td>

                  <!-- Kolom 7: Aksi Cepat (WA & Cetak Struk) -->
                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center space-x-2">
                      <!-- Tombol Kirim WA (Buka Tab Detail Status & WhatsApp Center) -->
                      <button onclick="previewSpecificReceipt('<%= order.id %>')" title="Buka Detail Status & WhatsApp Center" class="p-1.5 bg-emerald-50 text-emerald-800 hover:bg-emerald-600 hover:text-white rounded-lg transition border border-emerald-300 shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                      </button>
                      <!-- Tombol Struk (Pop-up Modal Nota Digital Thermal) -->
                      <button onclick="openThermalReceiptModal('<%= order.id %>')" title="Lihat Pop-up Struk Thermal" class="p-1.5 bg-slate-100 text-slate-700 hover:bg-teal-800 hover:text-white rounded-lg transition border border-slate-300 shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      </button>
                    </div>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- SECTION: MANAJEMEN LAYANAN LAUNDRY (CRUD DATABASE POSTGRESQL) -->
      <!-- ======================================================== -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
        
        <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50">
          <div>
            <div class="flex items-center space-x-2">
              <h3 class="font-black text-sm text-slate-900 tracking-tight">Katalog Layanan Laundry (CRUD Database PostgreSQL)</h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>PostgreSQL `mylaundry`</span>
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-0.5 font-medium">
              Data tersinkron langsung ke tabel <code class="font-mono text-teal-800 bg-teal-50 px-1 py-0.5 rounded font-bold">products</code>. Mendukung operasi <strong>Tambah (Create)</strong>, <strong>Tampil (Read)</strong>, <strong>Ubah (Update)</strong>, dan <strong>Hapus (Delete)</strong>.
            </p>
          </div>

          <button type="button" onclick="openAddProductModal()" class="px-4 py-2 bg-teal-800 hover:bg-teal-900 text-white rounded-xl text-xs font-black transition flex items-center space-x-1.5 shadow-xs flex-shrink-0 self-start sm:self-auto cursor-pointer">
            <span>+ Tambah Layanan Baru</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="text-[11px] font-black text-teal-50 uppercase tracking-wider bg-gradient-to-r from-teal-800 to-teal-700">
              <tr>
                <th class="py-3 px-4 w-12 text-center">ID</th>
                <th class="py-3 px-4">Layanan / Paket</th>
                <th class="py-3 px-4">Kategori</th>
                <th class="py-3 px-4">Harga / Tarif</th>
                <th class="py-3 px-4">Estimasi Waktu</th>
                <th class="py-3 px-4">Badge</th>
                <th class="py-3 px-4 text-center">Aksi CRUD</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
              <% products.forEach((pkg) => { %>
                <tr class="hover:bg-slate-50 transition" id="row-product-<%= pkg.id %>">
                  <td class="py-3 px-4 text-center font-mono font-bold text-slate-500"><%= pkg.id %></td>
                  <td class="py-3 px-4">
                    <div class="flex items-center space-x-2.5">
                      <span class="text-xl"><%= pkg.icon || '🧺' %></span>
                      <div>
                        <p class="font-black text-slate-900 leading-tight"><%= pkg.nama %></p>
                        <p class="text-[10px] text-slate-500 font-mono mt-0.5"><%= pkg.kode %></p>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                      <%= pkg.kategori || 'Kiloan' %>
                    </span>
                  </td>
                  <td class="py-3 px-4 font-mono font-black text-teal-800 text-sm">
                    <%= formatCurrency(pkg.harga) %><span class="text-[10px] font-normal text-slate-500">/<%= pkg.satuan || 'kg' %></span>
                  </td>
                  <td class="py-3 px-4 text-slate-700 font-bold">
                    <%= pkg.durasi_label || (pkg.estimasi_jam + ' Jam') %>
                  </td>
                  <td class="py-3 px-4">
                    <% if (pkg.badge) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-black bg-teal-50 text-teal-900 border border-teal-200">
                        <%= pkg.badge %>
                      </span>
                    <% } else { %>
                      <span class="text-slate-400 text-[11px]">-</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center space-x-1.5">
                      <!-- Edit Button -->
                      <button type="button" onclick='openEditProductModal(<%= JSON.stringify(pkg) %>)' title="Edit Layanan (Update)" class="px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 rounded-lg text-xs font-bold transition border border-amber-200 flex items-center space-x-1 shadow-2xs cursor-pointer">
                        <span>✏️ Edit</span>
                      </button>
                      <!-- Delete Button -->
                      <button type="button" onclick="confirmDeleteProduct(<%= pkg.id %>, '<%= pkg.nama %>')" title="Hapus Layanan (Delete)" class="px-2.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded-lg text-xs font-bold transition border border-rose-200 flex items-center space-x-1 shadow-2xs cursor-pointer">
                        <span>🗑️ Hapus</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>


    <!-- ======================================================== -->
    <!-- TAB 2: FORM TRANSAKSI BARU (PRD F-01 & F-02)             -->
    <!-- ======================================================== -->
    <div id="tab-transaksi" class="hidden space-y-6">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-lg font-black text-slate-900 tracking-tight">Form Transaksi Kasir Baru</h2>
          <p class="text-xs text-slate-600 font-medium">Input cucian masuk, pilih paket kiloan resmi, hitung otomatis, dan kirim nota WhatsApp.</p>
        </div>
        <button onclick="switchTab('dashboard')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold rounded-xl transition flex items-center space-x-1.5">
          <span>← Kembali ke Antrean</span>
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Form Kiri (Input Data) - 8 Kolom -->
        <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/90 shadow-card p-6 space-y-6">
          
          <!-- Alert Banner Validasi Error -->
          <div id="transaksi-error-banner" class="hidden bg-rose-50 border border-rose-300 text-rose-800 px-4 py-3 rounded-xl text-xs font-bold flex items-center space-x-2 animate-in fade-in">
            <span class="text-base flex-shrink-0">⚠️</span>
            <span id="transaksi-error-text">Mohon lengkapi data dengan benar.</span>
          </div>

          <!-- SECTION 1: PELANGGAN -->
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">1. Data Pelanggan</label>
              <span class="text-[11px] text-teal-800 font-extrabold bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200/80">Autocomplete Aktif</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Nama -->
              <div class="relative">
                <label class="block text-xs text-slate-700 font-bold mb-1">Nama Lengkap <span class="text-rose-600">*</span></label>
                <input type="text" id="cust-name" oninput="handleCustomerAutocomplete(this.value); document.getElementById('transaksi-error-banner').classList.add('hidden');" placeholder="Ketik nama pelanggan..." class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 font-bold transition">
                <!-- Autocomplete Dropdown -->
                <div id="autocomplete-box" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border-2 border-slate-200 rounded-xl shadow-lg z-30 max-h-48 overflow-y-auto divide-y divide-slate-100 text-xs"></div>
              </div>

              <!-- Nomor WhatsApp (HANYA ANGKA, 10-15 DIGIT) -->
              <div>
                <label class="block text-xs text-slate-700 font-bold mb-1">Nomor WhatsApp <span class="text-rose-600">*</span> <span class="text-[10px] text-slate-400 font-normal">(Hanya angka)</span></label>
                <div class="flex items-center">
                  <span class="px-3 py-2.5 bg-slate-200 text-slate-700 font-black text-xs rounded-l-xl border border-r-0 border-slate-300 font-mono">+62</span>
                  <input type="tel" id="cust-wa" inputmode="numeric" pattern="[0-9]*" maxlength="15" oninput="this.value = this.value.replace(/[^0-9]/g, ''); document.getElementById('transaksi-error-banner').classList.add('hidden');" placeholder="81234567890" class="flex-1 px-3 py-2.5 text-xs rounded-r-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 font-mono font-bold transition">
                </div>
              </div>
            </div>
          </div>

          <!-- SECTION 2: PAKET LAYANAN DARI DATABASE POSTGRESQL -->
          <div class="space-y-4 pt-4 border-t border-slate-200/80">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">2. Paket Layanan Cucian</label>
                <span class="text-[11px] text-teal-800 font-bold bg-teal-50 px-2 py-0.5 rounded-full border border-teal-200/80">PostgreSQL (<%= products.length %> Layanan)</span>
              </div>
              <button type="button" onclick="openAddProductModal()" class="px-3 py-1 bg-gradient-to-r from-teal-700 to-emerald-700 hover:from-teal-800 hover:to-emerald-800 text-white rounded-lg text-xs font-extrabold transition flex items-center space-x-1 shadow-xs cursor-pointer">
                <span>+ Tambah Layanan</span>
              </button>
            </div>

            <!-- Grid 3 Paket Layanan (Bersih, Fokus Kasir, Tanpa Ikon Edit/Hapus Mengganggu) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5" id="package-selector">
              <% products.forEach((pkg, index) => { %>
                <div onclick="selectPackage('<%= pkg.kode %>', <%= pkg.harga %>, <%= pkg.estimasi_jam %>, '<%= pkg.nama %>')" 
                     id="pkg-<%= pkg.kode %>" 
                     class="pkg-card cursor-pointer rounded-2xl p-4 border-2 <%= index === 0 ? 'border-teal-600 bg-gradient-to-br from-teal-50/80 to-emerald-50/40 ring-2 ring-teal-500/10 shadow-sm' : 'border-slate-200 bg-white hover:border-teal-400 hover:bg-slate-50/60' %> text-left transition-all duration-200 hover:-translate-y-0.5 relative group">
                  <% if (pkg.badge) { %>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-black <%= index === 0 ? 'bg-teal-200 text-teal-950 border border-teal-300' : 'bg-slate-100 text-slate-700 border border-slate-200' %> absolute right-3 top-3">
                      <%= pkg.badge %>
                    </span>
                  <% } %>
                  <div class="text-2xl mb-1.5"><%= pkg.icon %></div>
                  <p class="text-xs font-black text-slate-900 leading-tight"><%= pkg.nama %></p>
                  <p class="text-[11px] text-slate-600 font-medium mt-0.5"><%= pkg.durasi_label %></p>
                  <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between">
                    <p class="text-sm font-black text-teal-800 font-mono">
                      <%= formatCurrency(pkg.harga) %><span class="text-[10px] font-normal text-slate-500">/<%= pkg.satuan %></span>
                    </p>
                    <span class="text-[10px] text-teal-700 font-bold bg-white px-2 py-0.5 rounded-full border border-teal-200 shadow-2xs">Pilih</span>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Timbangan Berat & Keterangan Jenis Pakaian -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              
              <!-- Timbangan Berat (kg) -->
              <div>
                <label class="block text-xs text-slate-700 font-bold mb-1">Berat Timbangan (Kg) <span class="text-rose-600">*</span></label>
                <div class="flex items-center space-x-2">
                  <button type="button" onclick="stepWeight(-0.5)" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-black text-base transition flex items-center justify-center border border-slate-300 cursor-pointer">-</button>
                  <input type="number" id="input-weight" step="0.1" min="0.5" max="200" value="3.5" onkeydown="if(['e','E','+','-'].includes(event.key)) event.preventDefault();" oninput="calculateTotal(); document.getElementById('transaksi-error-banner').classList.add('hidden');" class="flex-1 text-center py-2 text-sm font-black rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 font-mono">
                  <button type="button" onclick="stepWeight(0.5)" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-black text-base transition flex items-center justify-center border border-slate-300 cursor-pointer">+</button>
                </div>
                <!-- Quick Weight Chips -->
                <div class="flex items-center space-x-2 mt-2">
                  <span class="text-[10px] text-slate-500 font-bold">Cepat:</span>
                  <button type="button" onclick="setWeight(2)" class="px-2.5 py-0.5 rounded-lg text-[10px] bg-slate-100 text-slate-700 hover:bg-teal-100 hover:text-teal-900 font-bold border border-slate-300 cursor-pointer">2 kg</button>
                  <button type="button" onclick="setWeight(3.5)" class="px-2.5 py-0.5 rounded-lg text-[10px] bg-slate-100 text-slate-700 hover:bg-teal-100 hover:text-teal-900 font-bold border border-slate-300 cursor-pointer">3.5 kg</button>
                  <button type="button" onclick="setWeight(5)" class="px-2.5 py-0.5 rounded-lg text-[10px] bg-slate-100 text-slate-700 hover:bg-teal-100 hover:text-teal-900 font-bold border border-slate-300 cursor-pointer">5 kg</button>
                  <button type="button" onclick="setWeight(7)" class="px-2.5 py-0.5 rounded-lg text-[10px] bg-slate-100 text-slate-700 hover:bg-teal-100 hover:text-teal-900 font-bold border border-slate-300 cursor-pointer">7 kg</button>
                </div>
              </div>

              <!-- Keterangan Jenis Pakaian (PRD Bagian 7: pakaian campur, sprei, selimut) -->
              <div>
                <label class="block text-xs text-slate-700 font-bold mb-1">Keterangan Jenis Pakaian</label>
                <input type="text" id="input-notes" list="clothes-types" placeholder="Pakaian harian campur, sprei, selimut..." value="Pakaian harian campur" class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 font-semibold">
                <datalist id="clothes-types">
                  <option value="Pakaian harian campur">
                  <option value="Sprei & sarung bantal">
                  <option value="Selimut bulu & bedcover">
                </datalist>
                <p class="text-[10px] text-slate-500 font-medium mt-1">Sesuai catatan identifikasi rak toko (PRD Bagian 7).</p>
              </div>

            </div>
          </div>

          <!-- SECTION 3: STATUS & METODE BAYAR -->
          <div class="space-y-4 pt-4 border-t border-slate-200/80">
            <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">3. Pembayaran</label>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Status Bayar -->
              <div>
                <label class="block text-xs text-slate-700 font-bold mb-1.5">Status Pembayaran</label>
                <div class="grid grid-cols-2 gap-2">
                  <button type="button" onclick="setPaymentStatus('Lunas')" id="btn-status-lunas" class="px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-teal-600 bg-teal-50 text-teal-900 transition cursor-pointer">
                    ✓ Lunas Sekarang
                  </button>
                  <button type="button" onclick="setPaymentStatus('Belum Lunas')" id="btn-status-belum" class="px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400 cursor-pointer">
                    ⏳ Bayar Saat Ambil
                  </button>
                </div>
              </div>

              <!-- Cara Bayar -->
              <div>
                <label class="block text-xs text-slate-700 font-bold mb-1.5">Metode Bayar</label>
                <div class="grid grid-cols-2 gap-2">
                  <button type="button" onclick="setPaymentMethod('Tunai')" id="btn-method-tunai" class="px-3.5 py-2.5 rounded-xl text-xs font-black border-2 border-teal-600 bg-teal-50 text-teal-900 transition cursor-pointer">
                    💵 Tunai
                  </button>
                  <button type="button" onclick="setPaymentMethod('QRIS')" id="btn-method-qris" class="px-3.5 py-2.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-600 transition hover:border-slate-400 cursor-pointer">
                    📱 QRIS Toko
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Form Kanan (Ringkasan Biaya Fresh Eco-Luxe) - 4 Kolom -->
        <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200/90 shadow-card p-6 space-y-5 sticky top-20">
          <div class="border-b border-slate-200/80 pb-3">
            <h3 class="text-sm font-black text-slate-900">Ringkasan Biaya &amp; Estimasi</h3>
            <p class="text-[11px] text-slate-500 font-medium">Perhitungan otomatis (PRD F-02)</p>
          </div>

          <div class="space-y-3">
            <!-- Total Harga (Sleek Dark Luxury Gradient) -->
            <div class="bg-gradient-to-br from-slate-900 via-slate-950 to-teal-950 text-white rounded-2xl p-6 text-center shadow-lg border border-teal-800/40 relative overflow-hidden">
              <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>
              <span class="text-[11px] font-extrabold text-teal-300 uppercase tracking-widest">Total Biaya Cucian</span>
              <div class="text-3xl sm:text-4xl font-black font-mono mt-2 text-white tracking-tight">
                Rp <span id="display-total-price" class="text-teal-400">24.500</span>
              </div>
              <p class="text-[11px] text-slate-300 mt-1.5 font-medium" id="display-calc-detail">3.5 Kg × Rp 7.000 (Cuci Reguler)</p>
            </div>

            <!-- Estimasi Selesai -->
            <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-4 space-y-1">
              <span class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider">Perkiraan Siap Ambil</span>
              <p class="text-xs font-black text-slate-900" id="display-ready-time">Memuat estimasi...</p>
              <p class="text-[10px] text-teal-700 font-bold" id="weather-buffer-note">Buffer cuaca normal</p>
            </div>
          </div>

          <!-- Tombol Submit & Buat Nota -->
          <div class="pt-2 space-y-2">
            <button type="button" onclick="submitTransaction()" class="w-full py-4 bg-gradient-to-r from-teal-600 via-teal-700 to-emerald-700 hover:from-teal-700 hover:to-emerald-800 text-white font-black rounded-xl shadow-lg shadow-teal-700/25 hover:shadow-xl hover:shadow-teal-700/30 transition-all transform active:scale-[0.99] flex items-center justify-center space-x-2 text-xs uppercase tracking-wider cursor-pointer">
              <span>SIMPAN &amp; BUAT NOTA DIGITAL</span>
              <span>➔</span>
            </button>
            <p class="text-[10px] text-slate-400 text-center font-medium">Data tersimpan di PostgreSQL sebelum nota dikirim ke WhatsApp.</p>
          </div>
        </div>

      </div>

    </div>


    <!-- ======================================================== -->
    <!-- TAB 3: UJI REST API & MIDDLEWARE LOGGER (WEEK 7 RESMI)    -->
    <!-- ======================================================== -->
    <div id="tab-api-tester" class="hidden space-y-6">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <div class="flex items-center space-x-2">
            <h2 class="text-lg font-black text-slate-900 tracking-tight">Interactive REST API Console</h2>
            <span class="px-2 py-0.5 rounded text-[10px] font-black bg-teal-100 text-teal-800 border border-teal-300">PPAW Week 7 &amp; 8</span>
          </div>
          <p class="text-xs text-slate-600 font-medium">Uji endpoint `GET /api/status` dan `GET /api/produk` secara langsung dengan response JSON valid dari PostgreSQL.</p>
        </div>
        <button onclick="switchTab('dashboard')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold rounded-xl transition flex items-center space-x-1.5">
          <span>← Kembali ke Meja Kasir</span>
        </button>
      </div>

      <!-- Suite Endpoint CRUD Week 8 (PostgreSQL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        
        <!-- 1. GET /api/status -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 font-black rounded border border-emerald-300">GET</span>
                <code class="font-extrabold text-slate-900">/api/status</code>
              </div>
              <button onclick="testApiEndpoint('/api/status', 'response-status')" class="px-3 py-1 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
                ▶ Uji
              </button>
            </div>
            <p class="text-[11px] text-slate-600 font-medium mt-1">Status server &amp; status koneksi PostgreSQL.</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 text-emerald-400 font-mono text-[11px] overflow-x-auto max-h-40" id="response-status">
            // Klik tombol "Uji" di atas...
          </div>
        </div>

        <!-- 2. GET /api/produk -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 font-black rounded border border-emerald-300">GET</span>
                <code class="font-extrabold text-slate-900">/api/produk</code>
              </div>
              <button onclick="testApiEndpoint('/api/produk', 'response-produk')" class="px-3 py-1 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
                ▶ Uji
              </button>
            </div>
            <p class="text-[11px] text-slate-600 font-medium mt-1">Mengambil semua data produk dari PostgreSQL (Array JSON).</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 text-teal-300 font-mono text-[11px] overflow-x-auto max-h-40" id="response-produk">
            // Klik tombol "Uji" di atas...
          </div>
        </div>

        <!-- 3. GET /api/produk/:id -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 font-black rounded border border-emerald-300">GET</span>
                <code class="font-extrabold text-slate-900">/api/produk/:id</code>
              </div>
              <div class="flex items-center space-x-1">
                <input type="number" id="test-get-id" value="1" min="1" class="w-12 px-2 py-1 text-xs border border-slate-300 rounded font-mono text-center">
                <button onclick="testApiEndpoint('/api/produk/' + document.getElementById('test-get-id').value, 'response-get-id')" class="px-3 py-1 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
                  ▶ Uji
                </button>
              </div>
            </div>
            <p class="text-[11px] text-slate-600 font-medium mt-1">Detail 1 produk berdasarkan Primary Key ID dari PostgreSQL.</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 text-teal-300 font-mono text-[11px] overflow-x-auto max-h-40" id="response-get-id">
            // Masukkan ID dan klik "Uji"...
          </div>
        </div>

        <!-- 4. POST /api/produk -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-teal-100 text-teal-900 font-black rounded border border-teal-300">POST</span>
                <code class="font-extrabold text-slate-900">/api/produk</code>
              </div>
              <button onclick="testApiPost()" class="px-3 py-1 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
                ▶ Uji Tambah
              </button>
            </div>
            <p class="text-[11px] text-slate-600 font-medium mt-1">Uji POST data baru (misal: Cuci Helm) ke PostgreSQL.</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 text-amber-400 font-mono text-[11px] overflow-x-auto max-h-40" id="response-post">
            // Klik "Uji Tambah" di atas...
          </div>
        </div>

        <!-- 5. PUT /api/produk/:id -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-amber-100 text-amber-900 font-black rounded border border-amber-300">PUT</span>
                <code class="font-extrabold text-slate-900">/api/produk/:id</code>
              </div>
              <div class="flex items-center space-x-1">
                <input type="number" id="test-put-id" value="1" min="1" class="w-12 px-2 py-1 text-xs border border-slate-300 rounded font-mono text-center">
                <button onclick="testApiPut()" class="px-3 py-1 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
                  ▶ Uji Edit
                </button>
              </div>
            </div>
            <p class="text-[11px] text-slate-600 font-medium mt-1">Uji PUT ubah harga produk ID terpilih di PostgreSQL.</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 text-amber-400 font-mono text-[11px] overflow-x-auto max-h-40" id="response-put">
            // Masukkan ID dan klik "Uji Edit"...
          </div>
        </div>

        <!-- 6. DELETE /api/produk/:id -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center space-x-2 font-mono text-xs">
                <span class="px-2 py-0.5 bg-rose-100 text-rose-900 font-black rounded border border-rose-300">DELETE</span>
                <code class="font-extrabold text-slate-900">/api/produk/:id</code>
              </div>
