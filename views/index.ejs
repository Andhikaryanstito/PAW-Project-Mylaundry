          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-xl font-bold">
            🧺
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-card flex items-center justify-between">
          <div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Kanal Komunikasi</p>
            <h3 class="text-2xl font-black text-slate-900 mt-1">100% WhatsApp</h3>
            <p class="text-[11px] text-slate-500 font-medium mt-0.5">wa.me Click-to-Chat Resmi</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-xl font-bold">
            💬
          </div>
        </div>
      </div>

      <!-- Tabel CRM Pelanggan -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="text-[11px] font-black text-teal-50 uppercase tracking-wider bg-gradient-to-r from-teal-800 to-teal-700">
                <th class="py-3.5 px-4 w-12 text-center">No</th>
                <th class="py-3.5 px-4">Nama Pelanggan</th>
                <th class="py-3.5 px-4">Nomor WhatsApp</th>
                <th class="py-3.5 px-4">Alamat / Asal</th>
                <th class="py-3.5 px-4">Catatan Khusus Cucian</th>
                <th class="py-3.5 px-4 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="customer-table-body">
              <% customers.forEach((cust, idx) => { %>
                <tr class="cust-row hover:bg-slate-50 transition" 
                    id="cust-row-<%= cust.id %>"
                    data-name="<%= (cust.name || '').toLowerCase() %>" 
                    data-phone="<%= cust.phone || '' %>" 
                    data-notes="<%= (cust.note || cust.address || '').toLowerCase() %>">
                  <td class="py-3.5 px-4 text-center font-mono text-slate-400 font-bold"><%= idx + 1 %></td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 flex items-center justify-center font-black text-xs shadow-2xs">
                        <%= (cust.name || 'PL').split(' ').filter(Boolean).map(n=>n[0]).slice(0,2).join('') %>
                      </div>
                      <div>
                        <p class="font-bold text-slate-900 leading-snug"><%= cust.name %></p>
                        <p class="text-[10px] text-slate-400 font-mono">ID: <%= cust.id %></p>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-800 whitespace-nowrap">
                    <%= cust.phone %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600">
                    <%= cust.address || 'Pelanggan Sekitar Cabang Bantul' %>
                  </td>
                  <td class="py-3.5 px-4">
                    <% if (cust.note) { %>
                      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] bg-amber-50 text-amber-900 border border-amber-200 font-medium">
                        📝 <%= cust.note %>
                      </span>
                    <% } else { %>
                      <span class="text-slate-400 text-xs">Pakaian harian reguler</span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-1.5 flex-wrap">
                      <button onclick="directWhatsAppCustomer('<%= cust.phone %>', '<%= cust.name %>')" title="Kirim Chat WhatsApp" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-600 text-emerald-800 hover:text-white rounded-lg transition border border-emerald-300 text-[10px] font-bold">
                        💬 WA
                      </button>
                      <button onclick="autofillOrderForCustomer('<%= cust.name %>', '<%= cust.phone %>')" title="Buatkan Order Masuk" class="px-2 py-1 bg-slate-100 hover:bg-teal-800 text-slate-700 hover:text-white rounded-lg transition border border-slate-200 text-[10px] font-bold">
