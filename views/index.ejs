                <th class="py-2.5 px-4 text-left font-black text-slate-700 uppercase tracking-wider">Harga</th>
                <th class="py-2.5 px-4 text-left font-black text-slate-700 uppercase tracking-wider">Satuan</th>
                <th class="py-2.5 px-4 text-left font-black text-slate-700 uppercase tracking-wider">Estimasi</th>
                <th class="py-2.5 px-4 text-center font-black text-slate-700 uppercase tracking-wider">Aksi</th>
              </tr>
            </thead>
