<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- WRAPPER KONTEN UTAMA (DI SEBELAH KANAN SIDEBAR) -->
<div class="flex-1 flex flex-col min-h-screen overflow-x-hidden bg-slate-100">

  <!-- TOP HEADER BAR (PENCARIAN CEPAT & STATUS CUACA TOKO) -->
  <header class="sticky top-0 z-20 bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between gap-4 shadow-2xs">
    
    <!-- Search Bar Global / Cepat -->
    <div class="relative flex-1 max-w-lg">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <input type="text" id="top-search" oninput="handleGlobalSearch(this.value)" placeholder="Cari nama pelanggan, nomor WhatsApp, atau ID order..." class="w-full pl-10 pr-4 py-2.5 text-xs rounded-xl bg-slate-100 hover:bg-slate-200/70 focus:bg-white border border-slate-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 text-slate-900 placeholder-slate-400 transition font-medium">
    </div>

    <!-- Right Header Actions: Simulasi Cuaca & Tanggal -->
    <div class="flex items-center space-x-3 flex-shrink-0">
      
      <!-- Weather Simulation Button -->
      <button onclick="toggleWeather()" id="weather-btn" class="px-3.5 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-amber-100/80 text-amber-900 border border-amber-300 hover:bg-amber-200/80 transition shadow-2xs" title="Klik untuk simulasi cuaca hujan/cerah">
        <span id="weather-icon">☀️</span>
        <span id="weather-text" class="hidden sm:inline">Cerah (31°C)</span>
        <span class="text-[9px] bg-amber-200 text-amber-900 px-1.5 py-0.5 rounded font-black uppercase tracking-wider">Simulasi</span>
      </button>

      <!-- Tanggal Operasional Shift -->
      <div class="hidden md:flex items-center space-x-2 text-xs text-slate-600 pl-3 border-l border-slate-200 font-semibold">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span><%= formatDateTime(new Date()).split(',')[0] %></span>
      </div>

    </div>
  </header>

  <!-- WEATHER ALERT BANNER (PRD US-06) -->
  <%- include('partials/weatherBanner') %>

  <!-- MAIN VIEWPORT CONTAINER -->
  <main class="p-6 md:p-8 space-y-6 flex-1">

    <!-- ======================================================== -->
    <!-- TAB 1: DASHBOARD PEMANTAUAN ANTREAN (PRD F-04 & FIGMA)   -->
    <!-- ======================================================== -->
    <div id="tab-dashboard" class="space-y-6">
      
      <!-- 4 HERO STATS CARDS (WARNA TEGAS, SOLID, DAN HIDUP) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Stat 1: Total Antrean Aktif -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-card hover:shadow-card-hover transition flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-slate-500 uppercase tracking-wider">Antrean Aktif</span>
            <span class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-base shadow-2xs">
              🧺
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-total-order"><%= stats.totalOrder %></h2>
              <span class="text-[10px] font-black text-blue-800 bg-blue-100 px-2 py-0.5 rounded-md border border-blue-300">Hari Ini</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">
              Beban toko: <strong class="text-slate-900 font-bold tabular-nums" id="stat-total-kg"><%= stats.totalKg %> Kg</strong> pakaian
            </p>
          </div>
        </div>

        <!-- Stat 2: Sedang Diproses -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-card hover:shadow-card-hover transition flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-amber-800 uppercase tracking-wider">Sedang Diproses</span>
            <span class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-base shadow-2xs">
              ⏳
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-diproses"><%= stats.diprosesCount %></h2>
              <span class="text-[10px] font-black text-amber-900 bg-amber-100 px-2 py-0.5 rounded-md border border-amber-300">Cuci &amp; Setrika</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">
              <strong class="text-slate-900 font-bold tabular-nums"><%= stats.diprosesKg %> Kg</strong> dalam pengerjaan
            </p>
          </div>
        </div>

        <!-- Stat 3: Siap Diambil -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-card hover:shadow-card-hover transition flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-emerald-800 uppercase tracking-wider">Siap Diambil</span>
            <span class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-base shadow-2xs">
              ✓
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight tabular-nums" id="stat-siap"><%= stats.siapCount %></h2>
              <span class="text-[10px] font-black text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded-md border border-emerald-300">Di Rak Toko</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 font-medium">Siap diserahkan ke pelanggan</p>
          </div>
        </div>

        <!-- Stat 4: Menumpuk >3 Hari -->
        <div class="bg-white rounded-2xl p-5 border-2 border-rose-200 shadow-card hover:shadow-card-hover transition flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-rose-700 uppercase tracking-wider">Menumpuk &gt;3 Hari</span>
            <span class="w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center font-bold text-base shadow-2xs">
              ⚠️
            </span>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline space-x-2">
              <h2 class="text-3xl font-black text-rose-700 tracking-tight tabular-nums" id="stat-menumpuk"><%= stats.menumpukCount %></h2>
              <span class="text-[10px] font-black text-rose-900 bg-rose-100 px-2 py-0.5 rounded-md border border-rose-300">Perlu Diingatkan</span>
            </div>
            <p class="text-xs text-rose-700 mt-1.5 font-semibold">Menghambat rak penyimpanan</p>
          </div>
        </div>

      </div>

      <!-- TABEL ANTREAN UTAMA: 100% LEBAR & KONTRAS TINGGI -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden space-y-4 p-6">
        
        <!-- Table Toolbar -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
          <div>
            <div class="flex items-center space-x-2.5">
              <h3 class="text-base font-black text-slate-900 tracking-tight">Daftar Antrean Cucian Toko</h3>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-blue-100 text-blue-800 border border-blue-300" id="visible-count">
                <%= orders.length %>
              </span>
            </div>
            <p class="text-xs text-slate-500 font-medium mt-0.5">
              Urutan antrean pengerjaan cucian terurut berdasarkan estimasi siap ambil.
            </p>
          </div>

          <div class="flex items-center space-x-3 w-full sm:w-auto">
            <!-- Filter Tabs -->
            <div class="flex items-center p-1 bg-slate-100 rounded-xl space-x-1 text-xs font-bold text-slate-700 border border-slate-200">
              <button onclick="setFilter('all')" id="filter-all" class="filter-btn px-3 py-1.5 rounded-lg bg-blue-600 text-white shadow-2xs transition">
                Semua (<%= orders.length %>)
              </button>
              <button onclick="setFilter('Diproses')" id="filter-diproses" class="filter-btn px-3 py-1.5 rounded-lg hover:text-blue-800 hover:bg-slate-200 transition">
                Diproses (<%= stats.diprosesCount %>)
              </button>
              <button onclick="setFilter('Siap Diambil')" id="filter-siapdiambil" class="filter-btn px-3 py-1.5 rounded-lg hover:text-blue-800 hover:bg-slate-200 transition">
                Siap (<%= stats.siapCount %>)
              </button>
              <button onclick="setFilter('Menumpuk')" id="filter-menumpuk" class="filter-btn px-3 py-1.5 rounded-lg text-rose-700 hover:bg-rose-100 transition">
                Menumpuk (<%= stats.menumpukCount %>)
              </button>
            </div>

            <!-- Tombol Tambah Order Baru -->
            <button onclick="switchTab('transaksi')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-extrabold transition flex items-center space-x-1.5 shadow-sm flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
              <span>+ Order Baru</span>
            </button>
          </div>
        </div>

        <!-- Tabel Responsif & Lega -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="orders-table">
            <thead>
              <tr class="border-b-2 border-slate-200 text-[11px] font-black text-slate-500 uppercase tracking-wider bg-slate-100/80">
                <th class="py-3.5 px-4">Order ID</th>
                <th class="py-3.5 px-4">Pelanggan</th>
                <th class="py-3.5 px-4">Paket &amp; Berat</th>
                <th class="py-3.5 px-4">Estimasi Siap</th>
                <th class="py-3.5 px-4">Status Cucian</th>
                <th class="py-3.5 px-4">Status Bayar</th>
                <th class="py-3.5 px-4 text-center">Aksi Cepat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-xs">
              <% orders.forEach(order => { %>
                <tr class="order-row hover:bg-blue-50/40 transition group" 
                    data-status="<%= order.status %>" 
                    data-name="<%= order.name.toLowerCase() %>" 
                    data-id="<%= order.id.toLowerCase() %>">
                  
                  <!-- Kolom 1: Order ID -->
                  <td class="py-3.5 px-4 font-mono font-extrabold text-blue-800 whitespace-nowrap">
                    <%= order.id %>
                  </td>

                  <!-- Kolom 2: Pelanggan (Dual-Line: Nama + Phone) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <p class="font-extrabold text-slate-900 leading-snug"><%= order.name %></p>
                    <p class="text-[11px] font-mono text-slate-600 font-semibold mt-0.5"><%= order.phone %></p>
                  </td>

                  <!-- Kolom 3: Paket & Berat (Dual-Line) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <p class="font-extrabold text-slate-900 leading-snug"><%= order.packageName %></p>
                    <p class="text-[11px] text-slate-600 mt-0.5">
                      <span class="font-bold text-slate-800"><%= order.weight %> Kg</span> • 
                      <span class="font-mono text-blue-800 font-black"><%= formatCurrency(order.price) %></span>
                    </p>
                  </td>

                  <!-- Kolom 4: Estimasi Siap -->
                  <td class="py-3.5 px-4 whitespace-nowrap text-slate-700 font-semibold">
                    <%= order.readyTime %>
                  </td>

                  <!-- Kolom 5: Status Pakaian (Pill Badge Kontras) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <% if (order.status === 'Diproses') { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-processing px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>Diproses</span>
                      </button>
                    <% } else if (order.status === 'Siap Diambil') { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-ready px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span>✓</span>
                        <span>Siap Diambil</span>
                      </button>
                    <% } else { %>
                      <button onclick="cycleStatus('<%= order.id %>')" title="Klik untuk ubah status pengerjaan" class="badge-overdue px-3 py-1 rounded-full text-[11px] font-extrabold inline-flex items-center space-x-1.5 transition hover:scale-105 shadow-2xs">
                        <span>⚠️</span>
                        <span>&gt;3 Hari di Rak</span>
                      </button>
                    <% } %>
                  </td>

                  <!-- Kolom 6: Status Bayar -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <% if (order.paymentStatus === 'Lunas') { %>
                      <span class="badge-paid px-2.5 py-1 rounded-full text-[11px] font-extrabold shadow-2xs">
                        Lunas (<%= order.paymentMethod %>)
                      </span>
                    <% } else { %>
                      <span class="badge-unpaid px-2.5 py-1 rounded-full text-[11px] font-extrabold shadow-2xs">
                        Belum Lunas
                      </span>
                    <% } %>
                  </td>

                  <!-- Kolom 7: Aksi Cepat (WA & Cetak Struk) -->
                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center space-x-2">
                      <!-- Tombol Kirim WA -->
                      <button onclick="previewSpecificReceipt('<%= order.id %>')" title="Kirim Nota via WhatsApp" class="p-1.5 bg-emerald-100 text-emerald-800 hover:bg-emerald-600 hover:text-white rounded-lg transition border border-emerald-300 shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                      </button>
                      <!-- Tombol Struk -->
                      <button onclick="previewSpecificReceipt('<%= order.id %>')" title="Lihat Struk Thermal" class="p-1.5 bg-slate-100 text-slate-700 hover:bg-blue-600 hover:text-white rounded-lg transition border border-slate-300 shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      </button>
                    </div>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- SECTION: MANAJEMEN LAYANAN LAUNDRY (CRUD DATABASE POSTGRESQL) -->
      <!-- ======================================================== -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
        
        <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/70">
          <div>
            <div class="flex items-center space-x-2">
              <h3 class="font-black text-sm text-slate-900 tracking-tight">Katalog Layanan Laundry (CRUD Database PostgreSQL)</h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>PostgreSQL `mylaundry`</span>
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-0.5 font-medium">
              Data tersinkron langsung ke tabel <code class="font-mono text-blue-700 bg-blue-50 px-1 py-0.5 rounded font-bold">products</code>. Mendukung operasi <strong>Tambah (Create)</strong>, <strong>Tampil (Read)</strong>, <strong>Ubah (Update)</strong>, dan <strong>Hapus (Delete)</strong>.
            </p>
          </div>

          <button type="button" onclick="openAddProductModal()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-black transition flex items-center space-x-1.5 shadow-sm flex-shrink-0 self-start sm:self-auto cursor-pointer">
            <span>+ Tambah Layanan Baru</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/90 text-slate-700 font-extrabold uppercase tracking-wider text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3 px-4 w-12 text-center">ID</th>
                <th class="py-3 px-4">Layanan / Paket</th>
                <th class="py-3 px-4">Kategori</th>
                <th class="py-3 px-4">Harga / Tarif</th>
                <th class="py-3 px-4">Estimasi Waktu</th>
                <th class="py-3 px-4">Badge</th>
                <th class="py-3 px-4 text-center">Aksi CRUD</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
              <% products.forEach((pkg) => { %>
                <tr class="hover:bg-slate-50/80 transition" id="row-product-<%= pkg.id %>">
                  <td class="py-3 px-4 text-center font-mono font-bold text-slate-500"><%= pkg.id %></td>
                  <td class="py-3 px-4">
                    <div class="flex items-center space-x-2.5">
                      <span class="text-xl"><%= pkg.icon || '🧺' %></span>
                      <div>
                        <p class="font-black text-slate-900 leading-tight"><%= pkg.nama %></p>
                        <p class="text-[10px] text-slate-500 font-mono mt-0.5"><%= pkg.kode %></p>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                      <%= pkg.kategori || 'Kiloan' %>
                    </span>
                  </td>
                  <td class="py-3 px-4 font-mono font-black text-blue-800 text-sm">
                    <%= formatCurrency(pkg.harga) %><span class="text-[10px] font-normal text-slate-500">/<%= pkg.satuan || 'kg' %></span>
                  </td>
                  <td class="py-3 px-4 text-slate-700 font-bold">
                    <%= pkg.durasi_label || (pkg.estimasi_jam + ' Jam') %>
                  </td>
                  <td class="py-3 px-4">
                    <% if (pkg.badge) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-black bg-blue-100 text-blue-900 border border-blue-200">
                        <%= pkg.badge %>
                      </span>
                    <% } else { %>
                      <span class="text-slate-400 text-[11px]">-</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center space-x-1.5">
                      <!-- Edit Button -->
                      <button type="button" onclick='openEditProductModal(<%= JSON.stringify(pkg) %>)' title="Edit Layanan (Update)" class="px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 rounded-lg text-xs font-bold transition border border-amber-200 flex items-center space-x-1 shadow-2xs cursor-pointer">
                        <span>✏️ Edit</span>
                      </button>
                      <!-- Delete Button -->
                      <button type="button" onclick="confirmDeleteProduct(<%= pkg.id %>, '<%= pkg.nama %>')" title="Hapus Layanan (Delete)" class="px-2.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded-lg text-xs font-bold transition border border-rose-200 flex items-center space-x-1 shadow-2xs cursor-pointer">
                        <span>🗑️ Hapus</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>


    <!-- ======================================================== -->
    <!-- TAB 2: FORM TRANSAKSI BARU (PRD F-01 & F-02)             -->
    <!-- ======================================================== -->
    <div id="tab-transaksi" class="hidden space-y-6">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-lg font-black text-slate-900 tracking-tight">Form Transaksi Kasir Baru</h2>
          <p class="text-xs text-slate-600 font-medium">Input cucian masuk, pilih paket kiloan resmi, hitung otomatis, dan kirim nota WhatsApp.</p>
        </div>
        <button onclick="switchTab('dashboard')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold rounded-xl transition flex items-center space-x-1.5">
          <span>← Kembali ke Antrean</span>
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Form Kiri (Input Data) - 8 Kolom -->
        <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-card p-6 space-y-6">
          
          <!-- SECTION 1: PELANGGAN -->
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">1. Data Pelanggan</label>
              <span class="text-[11px] text-blue-800 font-extrabold bg-blue-100 px-2.5 py-0.5 rounded border border-blue-300">Autocomplete Aktif</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Nama -->
              <div class="relative">
                <label class="block text-xs text-slate-700 font-bold mb-1">Nama Lengkap <span class="text-rose-600">*</span></label>
                <input type="text" id="cust-name" oninput="handleCustomerAutocomplete(this.value)" placeholder="Ketik nama pelanggan..." class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-bold transition">
                <!-- Autocomplete Dropdown -->
                <div id="autocomplete-box" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border-2 border-slate-200 rounded-xl shadow-lg z-30 max-h-48 overflow-y-auto divide-y divide-slate-100 text-xs"></div>
