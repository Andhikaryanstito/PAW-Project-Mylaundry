<!-- CLIENT-SIDE JAVASCRIPT & STATE MANAGEMENT -->
<script>
  // Inisialisasi data dari backend controller EJS
  const backendProducts = <%- JSON.stringify(products) %>;
  const backendCustomers = <%- JSON.stringify(customers) %>;
  let orderList = <%- JSON.stringify(orders) %>;
  
  let currentFilter = 'all';
  let isRaining = false;
  let selectedPackageRate = backendProducts[0]?.harga || 7000;
  let selectedPackageHours = backendProducts[0]?.estimasi_jam || 48;
  let selectedPackageName = backendProducts[0]?.nama || 'Cuci Reguler';
  let selectedPackageCode = backendProducts[0]?.kode || 'reguler';
  let currentPaymentStatus = 'Lunas';
  let currentPaymentMethod = 'Tunai';
  let currentReceiptOrder = null;
  let isDrawerOpen = false;

  // TAB SWITCHER (FRESH ECO-LUXE THEME)
  function switchTab(tabId) {
    const allTabs = ['dashboard', 'transaksi', 'api-tester', 'status', 'ai-assistant', 'pelanggan', 'pengaturan'];
    allTabs.forEach(id => {
      const el = document.getElementById('tab-' + id);
      if (el) el.classList.add('hidden');
    });

    document.querySelectorAll('.nav-tab').forEach(el => {
      el.classList.remove('bg-teal-800', 'text-white', 'shadow-xs', 'bg-blue-600', 'bg-gradient-to-r', 'from-teal-700', 'to-emerald-700', 'shadow-md', 'shadow-teal-700/20');
      el.classList.add('text-slate-700', 'hover:text-teal-900', 'hover:bg-slate-100');
    });

    const targetTab = document.getElementById('tab-' + tabId);
    if (targetTab) targetTab.classList.remove('hidden');

    const activeNav = document.getElementById('nav-' + tabId);
    if (activeNav) {
      activeNav.classList.remove('text-slate-700', 'hover:text-teal-900', 'hover:bg-slate-100');
      activeNav.classList.add('bg-gradient-to-r', 'from-teal-700', 'to-emerald-700', 'text-white', 'shadow-md', 'shadow-teal-700/20');
    }

    // Jika buka tab status cucian, otomatis muat data pesanan aktif
    if (tabId === 'status') {
      const orderToShow = currentReceiptOrder || orderList[0];
      if (orderToShow) {
        populateStatusCucianTab(orderToShow);
      }
    }

    // Jika buka tab pelanggan (CRM), sinkronkan data terbaru dari server
    if (tabId === 'pelanggan') {
      syncCustomersFromApi();
    }
  }

  // SINKRONISASI OTOMATIS DATA PELANGGAN CRM DARI API/DATABASE
  async function syncCustomersFromApi() {
    try {
      const res = await fetch('/api/pelanggan');
      if (!res.ok) return;
      const data = await res.json();
      if (Array.isArray(data)) {
        data.forEach(cust => appendCustomerToCrmDom(cust));
      }
    } catch (e) {
      console.warn('Sync customer error:', e);
    }
  }

  function appendCustomerToCrmDom(cust) {
    const tbody = document.getElementById('customer-table-body');
    if (!tbody || !cust || !cust.id) return;

    // Jangan duplikat jika baris pelanggan sudah ada di tabel
    if (document.getElementById('cust-row-' + cust.id)) return;

    const rowCount = tbody.querySelectorAll('tr.cust-row').length + 1;
    const initials = (cust.name || 'PL').split(' ').filter(Boolean).map(n => n[0]).slice(0, 2).join('');

    const tr = document.createElement('tr');
    tr.className = 'cust-row hover:bg-slate-50 transition bg-emerald-50/40';
    tr.id = 'cust-row-' + cust.id;
    tr.setAttribute('data-name', (cust.name || '').toLowerCase());
    tr.setAttribute('data-phone', cust.phone || '');
    tr.setAttribute('data-notes', (cust.note || cust.address || '').toLowerCase());

    tr.innerHTML = `
      <td class="py-3.5 px-4 text-center font-mono text-slate-400 font-bold">${rowCount}</td>
      <td class="py-3.5 px-4 whitespace-nowrap">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 flex items-center justify-center font-black text-xs shadow-2xs">
            ${initials}
          </div>
          <div>
            <p class="font-bold text-slate-900 leading-snug">${cust.name}</p>
            <p class="text-[10px] text-slate-400 font-mono">ID: ${cust.id}</p>
          </div>
        </div>
      </td>
      <td class="py-3.5 px-4 font-mono font-bold text-slate-800 whitespace-nowrap">
        ${cust.phone}
      </td>
      <td class="py-3.5 px-4 text-slate-600">
        ${cust.address || 'Pelanggan Sekitar Cabang Bantul'}
      </td>
      <td class="py-3.5 px-4">
        ${cust.note 
          ? `<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] bg-amber-50 text-amber-900 border border-amber-200 font-medium">
               📝 ${cust.note}
             </span>`
          : '<span class="text-slate-400 text-xs">Pakaian harian reguler</span>'
        }
      </td>
      <td class="py-3.5 px-4 text-center whitespace-nowrap">
        <div class="flex items-center justify-center gap-1.5 flex-wrap">
          <button onclick="directWhatsAppCustomer('${cust.phone}', \`${cust.name}\`)" title="Kirim Chat WhatsApp" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-600 text-emerald-800 hover:text-white rounded-lg transition border border-emerald-300 text-[10px] font-bold cursor-pointer">
            💬 WA
          </button>
          <button onclick="autofillOrderForCustomer(\`${cust.name}\`, '${cust.phone}')" title="Buatkan Order Masuk" class="px-2 py-1 bg-slate-100 hover:bg-teal-800 text-slate-700 hover:text-white rounded-lg transition border border-slate-200 text-[10px] font-bold cursor-pointer">
            + Order
          </button>
