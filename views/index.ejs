            <label class="block text-xs font-bold text-slate-700 mb-1">Nama Paket *</label>
            <input type="text" id="edit-paket-nama" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 font-semibold">
          </div>
          <div class="grid grid-cols-2 gap-3">
