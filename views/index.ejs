            <div>
              <h3 class="font-black text-sm text-slate-900">Kelola Paket Layanan</h3>
              <p class="text-xs text-slate-500 font-medium">Tambah, ubah nama/harga/durasi, atau hapus paket cucian dari database PostgreSQL.</p>
            </div>
          </div>
          <button onclick="toggleTambahPaket()" class="px-3 py-1.5 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5">
            <span>＋</span> Tambah Paket
          </button>
        </div>

        <!-- Form Tambah Paket (tersembunyi by default) -->
        <div id="form-tambah-paket" class="hidden bg-teal-50 border border-teal-200 rounded-xl p-4 space-y-3">
