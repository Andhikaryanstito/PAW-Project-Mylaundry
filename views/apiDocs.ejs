<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="flex-1 flex flex-col min-h-screen overflow-x-hidden bg-slate-50">

  <main class="p-6 md:p-8 space-y-6 flex-1">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-subtle space-y-2">
      <div class="flex items-center space-x-2">
        <span class="px-2.5 py-0.5 bg-blue-100 text-blue-800 text-xs font-bold rounded-md border border-blue-200">
          Spesifikasi Tugas Praktikum Week 7
        </span>
      </div>
      <h1 class="text-xl font-extrabold tracking-tight text-slate-900">Dokumentasi REST API &amp; Middleware Logger</h1>
      <p class="text-xs text-slate-500 max-w-2xl font-medium leading-relaxed">
        Pengujian endpoint resmi <code class="bg-slate-100 text-blue-700 px-1.5 py-0.5 rounded font-mono font-bold">GET /api/status</code> dan 
        <code class="bg-slate-100 text-blue-700 px-1.5 py-0.5 rounded font-mono font-bold">GET /api/produk</code> sesuai ketentuan Praktikum Pemrograman Aplikasi Web (PPAW - TI503P).
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Card 1 -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-subtle space-y-3">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-mono font-bold text-xs rounded">GET</span>
            <code class="font-mono font-bold text-slate-800 text-xs">/api/status</code>
          </div>
          <a href="/api/status" target="_blank" class="px-3 py-1 bg-slate-100 hover:bg-blue-50 hover:text-blue-800 text-slate-700 rounded-lg text-xs font-bold transition flex items-center space-x-1 border border-slate-200">
            <span>Buka Tab Baru ↗</span>
          </a>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Mengembalikan status server, uptime sistem, pemakaian memori, dan identitas toko dalam format JSON.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-subtle space-y-3">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-mono font-bold text-xs rounded">GET</span>
            <code class="font-mono font-bold text-slate-800 text-xs">/api/produk</code>
          </div>
          <a href="/api/produk" target="_blank" class="px-3 py-1 bg-slate-100 hover:bg-blue-50 hover:text-blue-800 text-slate-700 rounded-lg text-xs font-bold transition flex items-center space-x-1 border border-slate-200">
            <span>Buka Tab Baru ↗</span>
          </a>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Mengembalikan data 3 paket layanan cucian kiloan resmi (<code class="text-blue-700 font-semibold">Cuci Reguler</code>, <code class="text-blue-700 font-semibold">Cuci Kilat</code>, <code class="text-blue-700 font-semibold">Cuci Ekspress</code>) yang dikelola melalui Model backend (<code class="font-mono text-slate-600">productModel.js</code>).
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

</div>