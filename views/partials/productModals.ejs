<!-- 1. MODAL TAMBAH LAYANAN (CREATE) -->
<div id="modal-add-product" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl max-w-lg w-full border border-slate-200 shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Header Modal -->
    <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg font-bold shadow-xs">
          +
