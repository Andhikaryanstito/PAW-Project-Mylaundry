        <!-- Ikon Emoji -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Ikon Emoji</label>
          <select id="add-prod-icon" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-semibold text-slate-900 text-xs">
            <option value="🧺">🧺 Keranjang Cuci</option>
            <option value="⚡">⚡ Kilat / Express</option>
            <option value="🚀">🚀 Super Cepat</option>
            <option value="🛏️">🛏️ Bed Cover / Selimut</option>
            <option value="👟">👟 Sepatu & Tas</option>
            <option value="👔">👔 Kemeja / Jas</option>
            <option value="🧥">🧥 Jaket Tebal</option>
            <option value="🧹">🧹 Karpet & Tirai</option>
          </select>
        </div>

        <!-- Harga (Rp) -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Harga / Tarif (Rp) <span class="text-rose-600">*</span></label>
          <input type="number" id="add-prod-price" required min="1000" step="500" placeholder="10000" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-mono font-bold text-slate-900 text-xs">
        </div>

        <!-- Satuan -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Satuan Hitung</label>
          <input type="text" id="add-prod-unit" value="kg" placeholder="kg / pcs / meter / pasang" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-semibold text-slate-900 text-xs">
        </div>

        <!-- Estimasi Jam -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Estimasi Jam Kerja</label>
          <input type="number" id="add-prod-hours" value="24" min="1" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-mono font-bold text-slate-900 text-xs">
        </div>

        <!-- Durasi Label -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Label Durasi Tampil</label>
          <input type="text" id="add-prod-durasi" placeholder="Contoh: 1 Hari (24 Jam)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-semibold text-slate-900 text-xs">
        </div>

        <!-- Badge -->
        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">Badge Promosi (Opsional)</label>
          <input type="text" id="add-prod-badge" placeholder="Contoh: Paling Hemat / Populer / Promo" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-semibold text-slate-900 text-xs">
        </div>

        <!-- Deskripsi -->
        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">Deskripsi Layanan</label>
          <textarea id="add-prod-desc" rows="2" placeholder="Jelaskan proses cuci, pewangi, atau ketentuan layanan..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-medium text-slate-900 text-xs"></textarea>
        </div>
      </div>

      <!-- Footer Action -->
      <div class="pt-3 border-t border-slate-200 flex items-center justify-end space-x-2">
        <button type="button" onclick="closeAddProductModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition">
          Batal
        </button>
        <button type="submit" id="btn-save-add" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-xl shadow-xs transition flex items-center space-x-1.5">
          <span>💾 Simpan ke Database</span>
        </button>
      </div>

    </form>
  </div>
</div>


