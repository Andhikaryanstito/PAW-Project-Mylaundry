      <button type="button" onclick="closeAddProductModal()" class="w-8 h-8 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-600 flex items-center justify-center text-sm font-bold transition">
        ✕
      </button>
    </div>

    <!-- Form Tambah -->
    <form id="form-add-product" onsubmit="submitAddProduct(event)" class="p-6 space-y-4 text-xs">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <!-- Nama Layanan -->
        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">Nama Layanan / Paket <span class="text-rose-600">*</span></label>
