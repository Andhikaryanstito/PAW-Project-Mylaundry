<!-- 3. JAVASCRIPT LOGIC CRUD PRODUK POSTGRESQL -->
<script>
  // MODAL TAMBAH
  function openAddProductModal() {
    const modal = document.getElementById('modal-add-product');
    if (modal) {
      document.getElementById('form-add-product').reset();
      document.getElementById('add-prod-durasi').value = '1 Hari (24 Jam)';
      modal.classList.remove('hidden');
    }
  }

  function closeAddProductModal() {
    const modal = document.getElementById('modal-add-product');
    if (modal) modal.classList.add('hidden');
  }

  async function submitAddProduct(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-save-add');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>Menyimpan ke PostgreSQL...</span>';

    const payload = {
      nama: document.getElementById('add-prod-name').value.trim(),
      kategori: document.getElementById('add-prod-kategori').value,
      icon: document.getElementById('add-prod-icon').value,
      harga: parseInt(document.getElementById('add-prod-price').value, 10),
      satuan: document.getElementById('add-prod-unit').value.trim() || 'kg',
      estimasi_jam: parseInt(document.getElementById('add-prod-hours').value, 10) || 24,
      durasi_label: document.getElementById('add-prod-durasi').value.trim() || `${document.getElementById('add-prod-hours').value} Jam`,
      badge: document.getElementById('add-prod-badge').value.trim(),
      deskripsi: document.getElementById('add-prod-desc').value.trim()
    };

    try {
      const res = await fetch('/api/produk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok) {
        alert('✅ Berhasil! Layanan "' + payload.nama + '" berhasil disimpan ke database PostgreSQL.');
        closeAddProductModal();
        window.location.reload();
      } else {
        alert('❌ Gagal menambahkan: ' + (data.message || 'Terjadi kesalahan.'));
      }
    } catch (err) {
      alert('❌ Error koneksi: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // MODAL EDIT
  function openEditProductModal(pkg) {
    const modal = document.getElementById('modal-edit-product');
    if (!modal) return;

    document.getElementById('edit-prod-id').value = pkg.id;
    document.getElementById('edit-display-id').textContent = pkg.id;
    document.getElementById('edit-prod-name').value = pkg.nama || '';
    document.getElementById('edit-prod-kategori').value = pkg.kategori || 'Kiloan';
    document.getElementById('edit-prod-icon').value = pkg.icon || '🧺';
    document.getElementById('edit-prod-price').value = pkg.harga || '';
    document.getElementById('edit-prod-unit').value = pkg.satuan || 'kg';
    document.getElementById('edit-prod-hours').value = pkg.estimasi_jam || 24;
    document.getElementById('edit-prod-durasi').value = pkg.durasi_label || '';
    document.getElementById('edit-prod-badge').value = pkg.badge || '';
    document.getElementById('edit-prod-desc').value = pkg.deskripsi || '';

    modal.classList.remove('hidden');
  }

  function closeEditProductModal() {
    const modal = document.getElementById('modal-edit-product');
    if (modal) modal.classList.add('hidden');
  }

  async function submitEditProduct(e) {
    e.preventDefault();
    const id = document.getElementById('edit-prod-id').value;
    const btn = document.getElementById('btn-save-edit');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>Memperbarui di PostgreSQL...</span>';

    const payload = {
      nama: document.getElementById('edit-prod-name').value.trim(),
      kategori: document.getElementById('edit-prod-kategori').value,
      icon: document.getElementById('edit-prod-icon').value,
      harga: parseInt(document.getElementById('edit-prod-price').value, 10),
      satuan: document.getElementById('edit-prod-unit').value.trim() || 'kg',
      estimasi_jam: parseInt(document.getElementById('edit-prod-hours').value, 10) || 24,
      durasi_label: document.getElementById('edit-prod-durasi').value.trim() || `${document.getElementById('edit-prod-hours').value} Jam`,
      badge: document.getElementById('edit-prod-badge').value.trim(),
      deskripsi: document.getElementById('edit-prod-desc').value.trim()
    };

    try {
      const res = await fetch('/api/produk/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok) {
        alert('✅ Berhasil! Data layanan ID ' + id + ' (' + payload.nama + ') berhasil diperbarui di PostgreSQL.');
        closeEditProductModal();
        window.location.reload();
      } else {
        alert('❌ Gagal mengubah: ' + (data.message || 'Terjadi kesalahan.'));
      }
    } catch (err) {
      alert('❌ Error koneksi: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // HAPUS PRODUK (DELETE)
  async function confirmDeleteProduct(id, name) {
    const yakin = confirm('⚠️ PERINGATAN HAPUS DATA:\n\nApakah Anda yakin ingin menghapus layanan "' + name + '" (ID ' + id + ') dari database PostgreSQL?\n\nTindakan ini akan menghapus data secara permanen.');
    if (!yakin) return;

    try {
      const res = await fetch('/api/produk/' + id, {
        method: 'DELETE'
      });
      const data = await res.json();

      if (res.ok) {
        alert('🗑️ Berhasil! Layanan "' + name + '" telah dihapus dari database PostgreSQL.');
        window.location.reload();
      } else {
        alert('❌ Gagal menghapus: ' + (data.message || 'Terjadi kesalahan.'));
      }
    } catch (err) {
      alert('❌ Error koneksi: ' + err.message);
    }
  }
</script>
