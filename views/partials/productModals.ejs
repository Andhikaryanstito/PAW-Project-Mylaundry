          <label class="block font-bold text-slate-700 mb-1">Kategori <span class="text-rose-600">*</span></label>
          <select id="add-prod-kategori" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-semibold text-slate-900 text-xs">
            <option value="Kiloan">Kiloan</option>
            <option value="Satuan">Satuan</option>
