<!-- WEATHER ALERT BANNER (PRD F-07 & US-06 & Figma Wireframe) -->
<div id="weather-banner" class="hidden bg-amber-50 border-b border-amber-200 px-6 py-3 transition-all">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <span class="text-2xl">⚠️</span>
      <div>
        <p class="text-xs font-bold text-amber-900 uppercase tracking-wide">Peringatan Kendala Cuaca</p>
        <p class="text-xs text-amber-800 font-medium mt-0.5">
          Prakiraan cuaca mendeteksi <strong>potensi hujan lebat</strong> di sekitar toko. Waktu pengeringan pakaian berpotensi terlambat ~3 jam.
        </p>
      </div>
    </div>
    <div class="flex items-center space-x-2">
      <button onclick="askAIWeatherDraft()" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-sm transition flex items-center space-x-1.5">
        <span>💬 Kirim Pesan Delay Cuaca (WA)</span>
      </button>
      <button onclick="toggleWeather()" class="text-amber-700 hover:text-amber-900 text-xs font-medium px-2 py-1">Tutup</button>
    </div>
  </div>
</div>
