<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'MyLaundry POS - Website Kasir UMKM' %></title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            }
          },
          boxShadow: {
            'subtle': '0 1px 3px 0 rgba(15, 23, 42, 0.08), 0 1px 2px -1px rgba(15, 23, 42, 0.08)',
            'card': '0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 2px 6px -1px rgba(15, 23, 42, 0.05)',
            'card-hover': '0 12px 24px -4px rgba(15, 23, 42, 0.12), 0 4px 8px -2px rgba(15, 23, 42, 0.06)',
            'modal': '0 25px 50px -12px rgba(15, 23, 42, 0.25)',
            'drawer': '-12px 0 35px rgba(15, 23, 42, 0.15)',
          }
        }
      }
    }
  </script>
  
  <style>
    /* ====================================================
       VIBRANT ROYAL BLUE LAUNDRY THEME - MyLaundry POS
       Kontras Tinggi, Tegas, Segar, dan Tidak Pucat
    ==================================================== */

    body {
      background-color: #F1F5F9; /* Slate 100 */
      color: #0F172A;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Tabular figures for numbers, currency, and IDs */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #E2E8F0;
    }
    ::-webkit-scrollbar-thumb {
      background: #94A3B8;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #64748B;
    }

    /* Badges Status Tegas & Kontras (Tidak Pucat) */
    .badge-processing {
      background-color: #FEF3C7;
      color: #92400E;
      border: 1px solid #FCD34D;
    }
    .badge-ready {
      background-color: #D1FAE5;
      color: #065F46;
      border: 1px solid #6EE7B7;
    }
    .badge-overdue {
      background-color: #FEE2E2;
      color: #991B1B;
      border: 1px solid #FCA5A5;
    }
    .badge-paid {
      background-color: #DBEAFE;
      color: #1E40AF;
      border: 1px solid #93C5FD;
    }
    .badge-unpaid {
      background-color: #FFEDD5;
      color: #9A3412;
      border: 1px solid #FDBA74;
    }

    /* Animasi Smooth Drawer */
    .drawer-transition {
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
  </style>
</head>
<body class="flex bg-slate-100 min-h-screen text-slate-900 antialiased selection:bg-blue-200 selection:text-blue-900">