<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'MyLaundry POS - Website Kasir UMKM' %></title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0fdfa',
              100: '#ccfbf1',
              200: '#99f6e4',
              300: '#5eead4',
              400: '#2dd4bf',
              500: '#14b8a6',
              600: '#0d9488',
              700: '#0f766e',
              800: '#115e59',
              900: '#134e4a',
              950: '#042f2e',
            }
          },
          boxShadow: {
            'subtle': '0 1px 3px 0 rgba(28, 25, 23, 0.06), 0 1px 2px -1px rgba(28, 25, 23, 0.06)',
            'card': '0 4px 12px -2px rgba(28, 25, 23, 0.06), 0 2px 6px -1px rgba(28, 25, 23, 0.04)',
            'card-hover': '0 12px 24px -4px rgba(28, 25, 23, 0.10), 0 4px 8px -2px rgba(28, 25, 23, 0.04)',
            'modal': '0 25px 50px -12px rgba(28, 25, 23, 0.25)',
            'drawer': '-12px 0 35px rgba(28, 25, 23, 0.12)',
          }
        }
      }
    }
  </script>
  
  <style>
    /* ====================================================
       FRESH ECO-CLEAN LAUNDRY THEME - MyLaundry POS
       Natural, Earthy, Organic, Deep Forest Teal & Warm Linen
    ==================================================== */

    body {
      background-color: #FAFAF9; /* Warm Linen Stone 50 */
      color: #1C1917; /* Warm Dark Stone 900 */
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Tabular figures for numbers, currency, and IDs */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F5F5F4;
    }
    ::-webkit-scrollbar-thumb {
      background: #D6D3D1;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #A8A29E;
    }

    /* Badges Status Natural Kontras (Fresh Eco Style) */
    .badge-processing {
      background-color: #FEF3C7;
      color: #92400E;
      border: 1px solid #FDE68A;
    }
    .badge-ready {
      background-color: #CCFBF1;
      color: #115E59;
      border: 1px solid #99F6E4;
    }
    .badge-overdue {
      background-color: #FEE2E2;
      color: #991B1B;
      border: 1px solid #FECACA;
    }
    .badge-paid {
      background-color: #F0FDF4;
      color: #166534;
      border: 1px solid #BBF7D0;
    }
    .badge-unpaid {
      background-color: #FFF7ED;
      color: #9A3412;
      border: 1px solid #FED7AA;
    }

    /* Animasi Smooth Drawer */
    .drawer-transition {
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
  </style>
</head>
<body class="flex bg-stone-50 min-h-screen text-stone-900 antialiased selection:bg-teal-100 selection:text-teal-900">