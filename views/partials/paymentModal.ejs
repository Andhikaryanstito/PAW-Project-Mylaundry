<!-- MODAL UPDATE STATUS PEMBAYARAN & PELUNASAN KASIR -->
<div id="modal-pelunasan" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
  <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-slate-200 transform transition-all duration-200" id="modal-pelunasan-box">
    
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-teal-800 to-emerald-800 px-6 py-4 text-white flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center text-lg font-bold">
          💳
        </div>
        <div>
          <h4 class="font-black text-sm tracking-tight text-white leading-tight">Update Status Pembayaran</h4>
          <p class="text-[11px] text-teal-100 mt-0.5">Kasir POS • Pelunasan Transaksi Cucian</p>
        </div>
      </div>
      <button onclick="tutupModalPelunasan()" class="w-7 h-7 rounded-lg bg-teal-900/60 hover:bg-teal-900 text-teal-100 flex items-center justify-center text-xs font-bold transition cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 space-y-4 text-xs font-sans">
      
      <!-- Box Rincian Nota & Tagihan -->
      <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 space-y-2.5">
        <div class="flex justify-between items-center pb-2 border-b border-slate-200">
          <span class="text-slate-500 font-medium">No. Order Transaksi:</span>
          <span class="font-mono font-extrabold text-teal-800 text-xs px-2 py-0.5 bg-teal-50 rounded border border-teal-200" id="pay-modal-order-id">#ORD-000</span>
        </div>
        <div class="flex justify-between items-center py-0.5">
          <span class="text-slate-500 font-medium">Nama Pelanggan:</span>
          <span class="font-extrabold text-slate-900 text-xs" id="pay-modal-cust-name">-</span>
        </div>
        <div class="flex justify-between items-center py-0.5">
          <span class="text-slate-500 font-medium">Total Tagihan Cucian:</span>
          <span class="font-mono font-black text-slate-900 text-base" id="pay-modal-total-price">Rp 0</span>
        </div>
        <div class="flex justify-between items-center pt-2 border-t border-slate-200">
          <span class="text-slate-500 font-medium">Status Saat Ini:</span>
          <span id="pay-modal-current-badge" class="badge-unpaid px-2.5 py-0.5 rounded-full text-[10px] font-extrabold shadow-2xs">
            Belum Lunas
          </span>
        </div>
      </div>

      <!-- Action Choice -->
      <div class="space-y-2.5 pt-1">
        <label class="block text-[11px] font-black text-slate-500 uppercase tracking-wider">
          Pilih Status Pelunasan:
        </label>

        <!-- Option 1: Lunas - Tunai -->
        <button type="button" onclick="submitUpdatePembayaran('Lunas', 'Tunai')" 
                class="w-full p-3.5 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 hover:from-emerald-100 hover:to-teal-100 border-2 border-emerald-500 text-slate-900 transition flex items-center justify-between group shadow-2xs hover:shadow-sm cursor-pointer">
          <div class="flex items-center space-x-3">
            <span class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center text-lg font-bold shadow-xs">
              💵
            </span>
            <div class="text-left">
              <p class="font-black text-xs text-emerald-950 flex items-center space-x-1">
                <span>LUNAS - TUNAI (CASH)</span>
                <span class="text-[9px] bg-emerald-200 text-emerald-900 font-extrabold px-1.5 py-0.2 rounded-full">Populer</span>
              </p>
              <p class="text-[11px] text-slate-600 mt-0.5">Pelanggan membayar lunas dengan uang tunai</p>
            </div>
          </div>
          <span class="text-emerald-700 font-black text-base group-hover:translate-x-1 transition">➔</span>
        </button>

        <!-- Option 2: Lunas - QRIS -->
        <button type="button" onclick="submitUpdatePembayaran('Lunas', 'QRIS')" 
                class="w-full p-3.5 rounded-2xl bg-gradient-to-r from-teal-50 to-cyan-50 hover:from-teal-100 hover:to-cyan-100 border-2 border-teal-600 text-slate-900 transition flex items-center justify-between group shadow-2xs hover:shadow-sm cursor-pointer">
          <div class="flex items-center space-x-3">
            <span class="w-10 h-10 rounded-xl bg-teal-700 text-white flex items-center justify-center text-lg font-bold shadow-xs">
              📱
            </span>
            <div class="text-left">
              <p class="font-black text-xs text-teal-950">LUNAS - QRIS RESMI</p>
              <p class="text-[11px] text-slate-600 mt-0.5">Pelanggan scan barcode QRIS statis / dinamis</p>
            </div>
          </div>
          <span class="text-teal-700 font-black text-base group-hover:translate-x-1 transition">➔</span>
        </button>

        <!-- Option 3: Belum Lunas (Bayar Saat Ambil) -->
        <button type="button" onclick="submitUpdatePembayaran('Belum Lunas', '-')" 
                class="w-full p-2.5 rounded-2xl bg-amber-50/60 hover:bg-amber-100 border border-amber-300 text-amber-950 transition flex items-center justify-between group cursor-pointer">
          <div class="flex items-center space-x-2.5">
            <span class="text-base">⏳</span>
            <div class="text-left">
              <p class="font-extrabold text-[11px]">TETAPKAN BELUM LUNAS</p>
              <p class="text-[10px] text-slate-500">Bayar saat pengambilan pakaian nanti</p>
            </div>
          </div>
          <span class="text-amber-800 font-bold text-xs">Pilih</span>
        </button>
      </div>

      <!-- Footer Action -->
      <div class="pt-2">
        <button type="button" onclick="tutupModalPelunasan()" 
                class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer">
          Batal / Tutup
        </button>
      </div>

    </div>

  </div>
</div>
