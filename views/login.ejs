<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }

    body {
      background-color: #FAFAF9; /* Warm Linen */
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: #1C1917;
    }

    .input-clean {
      background: #F5F5F4;
      border: 1.5px solid #E7E5E4;
      color: #1C1917;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 500;
      width: 100%;
      transition: all 0.2s;
    }
    .input-clean::placeholder { color: #A8A29E; }
    .input-clean:focus {
      background: #FFFFFF;
      border-color: #0F766E;
      outline: none;
      box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }
    .btn-login {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 13px;
      color: white;
      background-color: #0F766E;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(15, 118, 110, 0.25);
    }
    .btn-login:hover {
      background-color: #115E59;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(15, 118, 110, 0.35);
    }
    .quick-btn {
      background: #F5F5F4;
      border: 1px solid #E7E5E4;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #44403C;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .quick-btn:hover {
      background: #F0FDFA;
      border-color: #99F6E4;
      color: #0F766E;
    }
  </style>
</head>
<body>

  <!-- MAIN LOGIN CARD -->
  <div class="max-w-4xl w-full bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[550px]">
    
    <!-- LEFT PANEL: BRAND & VALUE PROPS (FRESH ECO-CLEAN FOREST TEAL) -->
    <div class="md:col-span-5 bg-gradient-to-br from-[#0F766E] via-[#115E59] to-[#134E4A] p-8 md:p-10 text-white flex flex-col justify-between relative overflow-hidden">
      
      <!-- Subtle organic ambient circles -->
      <div class="absolute -right-16 -top-16 w-52 h-52 rounded-full bg-emerald-400/10 blur-2xl pointer-events-none"></div>
      <div class="absolute -left-12 -bottom-12 w-48 h-48 rounded-full bg-teal-300/10 blur-2xl pointer-events-none"></div>

      <!-- Top: Brand & Slogan -->
      <div class="relative z-10">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-10 h-10 rounded-2xl bg-white/15 text-white flex items-center justify-center font-bold text-xl shadow-xs border border-white/20 backdrop-blur-xs">
            🧺
          </div>
          <div>
            <h1 class="text-xl font-black tracking-tight text-white leading-none">MyLaundry <span class="text-teal-200">POS</span></h1>
            <p class="text-[11px] text-teal-100/80 font-medium mt-1">Sistem Meja Kasir UMKM Bersih &amp; Ramah</p>
          </div>
        </div>

        <p class="text-sm text-teal-50/90 leading-relaxed italic font-medium mb-6">
          "Mencuci bersih alami, menyetrika rapi, melayani sepenuh hati."
        </p>

        <!-- Feature Bullets (High Contrast, Human Warm Tone) -->
        <div class="space-y-3.5">
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-500/80 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs">✓</div>
            <span>Pencatatan order cepat &lt; 1 menit</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-500/80 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs">✓</div>
            <span>Estimasi jam selesai otomatis &amp; buffer cuaca</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-500/80 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs">✓</div>
            <span>Kirim nota digital WhatsApp 1-klik (wa.me)</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-500/80 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs">✓</div>
            <span>Asisten Cerdas Sarah AI (Google Gemini LLM)</span>
          </div>
        </div>
      </div>

      <!-- Bottom: Info Shift Toko -->
      <div class="relative z-10 bg-black/20 border border-white/15 rounded-2xl p-3.5 flex items-center space-x-3 text-xs backdrop-blur-xs mt-6">
        <span class="text-xl">🏪</span>
        <div>
          <p class="font-extrabold text-white">Toko Cabang Bantul</p>
          <p class="text-[11px] text-teal-100/80">Operasional Shift Buka: 08:00 - 21:00 WIB</p>
        </div>
      </div>

    </div>

    <!-- RIGHT PANEL: FORM LOGIN -->
    <div class="md:col-span-7 p-8 md:p-10 flex flex-col justify-center space-y-5 bg-white">
      
      <!-- Header -->
      <div>
        <span class="text-[10px] font-extrabold text-teal-800 bg-teal-50 border border-teal-200 px-2.5 py-1 rounded-md uppercase tracking-widest">
          Buka Meja Kasir
        </span>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-3">Selamat Datang Kembali 👋</h2>
        <p class="text-sm text-slate-500 mt-1">Masukkan kredensial akun kasir untuk memulai shift.</p>
      </div>

      <!-- Alert Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>⚠️</span>
          <span class="font-medium"><%= error %></span>
        </div>
      <% } %>
      <% if (typeof message !== 'undefined' && message === 'logout_success') { %>
        <div class="bg-teal-50 border border-teal-200 text-teal-800 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>✓</span>
          <span class="font-medium">Anda telah berhasil keluar dari shift kasir.</span>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4">
        
        <!-- Username -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Username Kasir</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">👤</span>
            <input type="text" name="username" id="input-username" required
              placeholder="sarah" value="sarah"
              class="input-clean pl-10">
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kata Sandi (PIN)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔒</span>
            <input type="password" name="password" id="input-password" required
              placeholder="Masukkan kata sandi..." value="password"
              class="input-clean pl-10 pr-10">
            <button type="button" onclick="togglePasswordVisibility()"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition text-sm p-1">
              👁
            </button>
          </div>
        </div>

        <!-- Remember Device -->
        <div class="flex items-center text-xs pt-0.5">
          <label class="flex items-center space-x-2 cursor-pointer text-slate-600">
            <input type="checkbox" checked class="w-3.5 h-3.5 rounded border-slate-300 text-teal-700 focus:ring-teal-500/20">
            <span class="font-medium">Ingat perangkat ini</span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-login">
          <span>MASUK KE MEJA KASIR</span>
          <span>➔</span>
        </button>

      </form>


      <!-- Login Cepat Sarah (1 user sesuai PRD) -->
      <div class="pt-4 border-t border-slate-100 space-y-2.5">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Login Cepat (1-Klik):</p>
        <button type="button" onclick="fillCredentials('sarah', 'password')" class="quick-btn w-full text-left p-2.5 flex items-center gap-2.5 group">
          <span class="text-base">🧺</span>
          <div>
            <div class="text-xs font-bold text-slate-800 group-hover:text-teal-800">Sarah Anggraini — Kasir &amp; Pemilik Toko</div>
            <div class="text-[10px] text-slate-500 font-mono">sarah / password</div>
          </div>
        </button>
      </div>

    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const input = document.getElementById('input-password');
      input.type = (input.type === 'password') ? 'text' : 'password';
    }

    function fillCredentials(user, pass) {
      document.getElementById('input-username').value = user;
      document.getElementById('input-password').value = pass;
    }
  </script>

</body>
</html>
