<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }

    body {
      background-color: #F1F5F9;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: #0F172A;
    }

    .input-clean {
      background: #F8FAFC;
      border: 1.5px solid #CBD5E1;
      color: #0F172A;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 500;
      width: 100%;
      transition: all 0.2s;
    }
    .input-clean::placeholder { color: #94A3B8; }
    .input-clean:focus {
      background: #FFFFFF;
      border-color: #2563EB;
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    }
    .btn-login {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 13px;
      color: white;
      background-color: #2563EB;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-login:hover {
      background-color: #1D4ED8;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }
    .quick-btn {
      background: #F1F5F9;
      border: 1px solid #E2E8F0;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .quick-btn:hover {
      background: #EFF6FF;
      border-color: #BFDBFE;
      color: #2563EB;
    }
  </style>
</head>
<body>

  <!-- MAIN LOGIN CARD -->
  <div class="max-w-4xl w-full bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[540px]">
    
    <!-- LEFT PANEL: BRAND & VALUE PROPS (DEEP BLUE LAUNDRY TONE) -->
    <div class="md:col-span-5 bg-gradient-to-br from-[#1E3A8A] via-[#1E40AF] to-[#0F172A] p-8 md:p-10 text-white flex flex-col justify-between relative overflow-hidden">
      
      <!-- Top: Brand & Slogan -->
      <div class="relative z-10">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-blue-950/60 text-white flex items-center justify-center font-bold text-xl shadow-md border border-blue-400/30">
            🧺
          </div>
          <div>
            <h1 class="text-xl font-extrabold tracking-tight text-white leading-none">MyLaundry <span class="text-blue-400">POS</span></h1>
            <p class="text-[11px] text-blue-200/80 font-medium mt-1">Sistem Meja Kasir UMKM</p>
          </div>
        </div>

        <p class="text-sm text-blue-100/90 leading-relaxed italic font-medium mb-6">
          "Mencuci bersih, menyetrika rapi, melayani sepenuh hati."
        </p>

        <!-- Feature Bullets (High Contrast Text) -->
        <div class="space-y-3.5">
          <div class="flex items-center space-x-3 text-xs font-medium text-white">
            <div class="w-5 h-5 rounded-full bg-blue-500 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-sm">✓</div>
            <span>Pencatatan order cepat &lt; 1 menit</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-white">
            <div class="w-5 h-5 rounded-full bg-blue-500 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-sm">✓</div>
            <span>Estimasi jam selesai otomatis berbasis antrean</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-white">
            <div class="w-5 h-5 rounded-full bg-blue-500 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-sm">✓</div>
            <span>Kirim nota digital via WhatsApp (wa.me)</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-white">
            <div class="w-5 h-5 rounded-full bg-blue-500 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-sm">✓</div>
            <span>Peringatan dini kendala cuaca hujan lebat</span>
          </div>
        </div>
      </div>

      <!-- Bottom: Info Shift Toko -->
      <div class="relative z-10 bg-blue-950/60 border border-blue-400/20 rounded-xl p-3.5 flex items-center space-x-3 text-xs backdrop-blur-sm mt-6">
        <span class="text-lg">🏪</span>
        <div>
          <p class="font-bold text-white">Toko Cabang Bantul</p>
          <p class="text-[11px] text-blue-200/70">Operasional Shift Buka: 08:00 - 21:00 WIB</p>
        </div>
      </div>

    </div>

    <!-- RIGHT PANEL: FORM LOGIN -->
    <div class="md:col-span-7 p-8 md:p-10 flex flex-col justify-center space-y-5 bg-white">
      
      <!-- Header -->
      <div>
        <span class="text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-md uppercase tracking-widest">
          Buka Meja Kasir
        </span>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-3">Selamat Datang Kembali 👋</h2>
        <p class="text-sm text-slate-500 mt-1">Masukkan kredensial untuk membuka shift meja kasir toko.</p>
      </div>

      <!-- Alert Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>⚠️</span>
          <span class="font-medium"><%= error %></span>
        </div>
      <% } %>
      <% if (typeof message !== 'undefined' && message === 'logout_success') { %>
        <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>✓</span>
          <span class="font-medium">Anda telah berhasil keluar dari shift kasir.</span>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4">
        
        <!-- Username -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Username Kasir</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">👤</span>
            <input type="text" name="username" id="input-username" required
              placeholder="sarah atau admin" value="sarah"
              class="input-clean pl-10">
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kata Sandi (PIN)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔒</span>
            <input type="password" name="password" id="input-password" required
              placeholder="Masukkan kata sandi..." value="password"
              class="input-clean pl-10 pr-10">
            <button type="button" onclick="togglePasswordVisibility()"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition text-sm p-1">
              👁
            </button>
          </div>
        </div>

        <!-- Remember & Forgot -->
        <div class="flex items-center justify-between text-xs pt-0.5">
          <label class="flex items-center space-x-2 cursor-pointer text-slate-600">
            <input type="checkbox" checked class="w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500/20">
            <span class="font-medium">Ingat perangkat ini</span>
          </label>
          <span class="text-blue-700 font-semibold hover:underline cursor-pointer">Lupa kata sandi?</span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-login">
          <span>MASUK KE MEJA KASIR</span>
          <span>➔</span>
        </button>

      </form>

      <!-- Quick Demo Login -->
      <div class="pt-4 border-t border-slate-100 space-y-2">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider text-center">Akun Uji Coba Cepat (1-Klik):</p>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" onclick="fillCredentials('sarah', 'password')" class="quick-btn">
            <span>👤 Kasir Sarah</span>
          </button>
          <button type="button" onclick="fillCredentials('admin', 'admin')" class="quick-btn">
            <span>🛡 Admin Toko</span>
          </button>
        </div>
        <p class="text-center text-[10px] text-slate-400 font-mono">Kredensial demo: <span class="text-blue-700 font-semibold">sarah</span> / <span class="text-blue-700 font-semibold">password</span></p>
      </div>

    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const input = document.getElementById('input-password');
      input.type = (input.type === 'password') ? 'text' : 'password';
    }

    function fillCredentials(user, pass) {
      document.getElementById('input-username').value = user;
      document.getElementById('input-password').value = pass;
    }
  </script>

</body>
</html>