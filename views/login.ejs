<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }

    body {
      background:
        radial-gradient(at 12% 18%, rgba(20, 184, 166, 0.28) 0px, transparent 52%),
        radial-gradient(at 88% 15%, rgba(16, 185, 129, 0.26) 0px, transparent 50%),
        radial-gradient(at 82% 85%, rgba(13, 148, 136, 0.30) 0px, transparent 55%),
        radial-gradient(at 18% 88%, rgba(52, 211, 153, 0.22) 0px, transparent 50%),
        linear-gradient(135deg, #ECFDF5 0%, #F0FDFA 48%, #E2E8F0 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: #1C1917;
      position: relative;
      overflow-x: hidden;
    }

    /* Pola titik halus di latar belakang */
    .bg-grid-dots {
      background-image: radial-gradient(rgba(15, 118, 110, 0.16) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    /* Animasi lembut cahaya ambient di belakang kaca */
    @keyframes floatOrb {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(22px, -18px) scale(1.06); }
    }
    .ambient-orb-1 { animation: floatOrb 12s ease-in-out infinite; }
    .ambient-orb-2 { animation: floatOrb 15s ease-in-out infinite reverse; }

    /* Kartu Utama Glassmorphism */
    .glass-card-main {
      background: rgba(255, 255, 255, 0.68);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(255, 255, 255, 0.85);
      box-shadow:
        0 25px 55px -12px rgba(15, 118, 110, 0.20),
        0 10px 25px -8px rgba(15, 23, 42, 0.08),
        inset 0 1px 0 0 rgba(255, 255, 255, 0.92);
    }

    /* Panel Kiri Frosted Deep Teal */
    .glass-left-panel {
      background: linear-gradient(145deg, rgba(15, 118, 110, 0.90) 0%, rgba(17, 94, 89, 0.93) 50%, rgba(19, 78, 74, 0.96) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    /* Panel Kanan Frosted White */
    .glass-right-panel {
      background: rgba(255, 255, 255, 0.58);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .input-clean {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1.5px solid rgba(203, 213, 225, 0.85);
      color: #1C1917;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 500;
      width: 100%;
      transition: all 0.2s;
    }
    .input-clean::placeholder { color: #A8A29E; }
    .input-clean:focus {
      background: rgba(255, 255, 255, 0.96);
      border-color: #0F766E;
      outline: none;
      box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.16);
    }

    .btn-login {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 13px;
      color: white;
      background: linear-gradient(135deg, #0F766E 0%, #059669 100%);
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 18px rgba(15, 118, 110, 0.28);
    }
    .btn-login:hover {
      background: linear-gradient(135deg, #115E59 0%, #047857 100%);
      transform: translateY(-1px);
      box-shadow: 0 10px 22px rgba(15, 118, 110, 0.36);
    }

    .quick-btn {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(203, 213, 225, 0.8);
      border-radius: 12px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #44403C;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .quick-btn:hover {
      background: rgba(240, 253, 250, 0.92);
      border-color: #5EEAD4;
      color: #0F766E;
      box-shadow: 0 4px 12px rgba(15, 118, 110, 0.10);
    }
  </style>
</head>
<body>

  <!-- LAYER DEKORASI GLASSMORPHISM BACKGROUND -->
  <div class="fixed inset-0 bg-grid-dots pointer-events-none z-0"></div>
  <div class="fixed -top-24 -left-24 w-96 h-96 rounded-full bg-teal-400/30 blur-3xl pointer-events-none ambient-orb-1 z-0"></div>
  <div class="fixed -bottom-28 -right-20 w-[28rem] h-[28rem] rounded-full bg-emerald-400/30 blur-3xl pointer-events-none ambient-orb-2 z-0"></div>
  <div class="fixed top-1/3 right-1/4 w-72 h-72 rounded-full bg-cyan-300/25 blur-3xl pointer-events-none z-0"></div>

  <!-- MAIN LOGIN CARD (GLASSMORPHISM) -->
  <div class="relative z-10 max-w-4xl w-full glass-card-main rounded-3xl overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[550px]">
    
    <!-- LEFT PANEL: BRAND & VALUE PROPS (FROSTED ECO-CLEAN FOREST TEAL) -->
    <div class="md:col-span-5 glass-left-panel p-8 md:p-10 text-white flex flex-col justify-between relative overflow-hidden">
      
      <!-- Subtle organic ambient circles -->
      <div class="absolute -right-16 -top-16 w-52 h-52 rounded-full bg-emerald-300/20 blur-2xl pointer-events-none"></div>
      <div class="absolute -left-12 -bottom-12 w-48 h-48 rounded-full bg-teal-200/15 blur-2xl pointer-events-none"></div>

      <!-- Top: Brand & Slogan -->
      <div class="relative z-10">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-10 h-10 rounded-2xl bg-white/15 text-white flex items-center justify-center font-bold text-xl shadow-xs border border-white/25 backdrop-blur-md">
            🧺
          </div>
          <div>
            <h1 class="text-xl font-black tracking-tight text-white leading-none">MyLaundry <span class="text-teal-200">POS</span></h1>
            <p class="text-[11px] text-teal-100/80 font-medium mt-1">Sistem Meja Kasir UMKM Bersih &amp; Ramah</p>
          </div>
        </div>

        <p class="text-sm text-teal-50/90 leading-relaxed italic font-medium mb-6">
          "Mencuci bersih alami, menyetrika rapi, melayani sepenuh hati."
        </p>

        <!-- Feature Bullets (High Contrast, Human Warm Tone) -->
        <div class="space-y-3.5">
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-400/30 border border-emerald-300/40 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs backdrop-blur-sm">✓</div>
            <span>Pencatatan order cepat &lt; 1 menit</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-400/30 border border-emerald-300/40 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs backdrop-blur-sm">✓</div>
            <span>Estimasi jam selesai otomatis &amp; buffer cuaca</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-400/30 border border-emerald-300/40 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs backdrop-blur-sm">✓</div>
            <span>Kirim nota digital WhatsApp 1-klik (wa.me)</span>
          </div>
          <div class="flex items-center space-x-3 text-xs font-medium text-teal-50">
            <div class="w-5 h-5 rounded-full bg-emerald-400/30 border border-emerald-300/40 text-white flex items-center justify-center font-extrabold text-[10px] flex-shrink-0 shadow-xs backdrop-blur-sm">✓</div>
            <span>Asisten Cerdas Sarah AI (Google Gemini LLM)</span>
          </div>
        </div>
      </div>

      <!-- Bottom: Info Shift Toko (Frosted Glass Subcard) -->
      <div class="relative z-10 bg-white/10 border border-white/20 rounded-2xl p-3.5 flex items-center space-x-3 text-xs backdrop-blur-md shadow-inner mt-6">
        <span class="text-xl">🏪</span>
        <div>
          <p class="font-extrabold text-white">Toko Cabang Bantul</p>
          <p class="text-[11px] text-teal-100/85">Operasional Shift Buka: 08:00 - 21:00 WIB</p>
        </div>
      </div>

    </div>

    <!-- RIGHT PANEL: FORM LOGIN (FROSTED GLASS) -->
    <div class="md:col-span-7 glass-right-panel p-8 md:p-10 flex flex-col justify-center space-y-5">
      
      <!-- Header -->
      <div>
        <span class="text-[10px] font-extrabold text-teal-800 bg-teal-500/10 border border-teal-500/25 backdrop-blur-xs px-2.5 py-1 rounded-md uppercase tracking-widest">
          Buka Meja Kasir
        </span>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-3">Selamat Datang Kembali 👋</h2>
        <p class="text-sm text-slate-600 mt-1">Masukkan kredensial akun kasir untuk memulai shift.</p>
      </div>

      <!-- Alert Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-500/10 backdrop-blur-xs border border-rose-300/80 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>⚠️</span>
          <span class="font-medium"><%= error %></span>
        </div>
      <% } %>
      <% if (typeof message !== 'undefined' && message === 'logout_success') { %>
        <div class="bg-teal-500/10 backdrop-blur-xs border border-teal-300/80 text-teal-900 px-4 py-3 rounded-xl text-xs flex items-center space-x-2">
          <span>✓</span>
          <span class="font-medium">Anda telah berhasil keluar dari shift kasir.</span>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4">
        
        <!-- Username -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Username Kasir</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">👤</span>
            <input type="text" name="username" id="input-username" required
              placeholder="sarah" value="sarah"
              class="input-clean pl-10">
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kata Sandi (PIN)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔒</span>
            <input type="password" name="password" id="input-password" required
              placeholder="Masukkan kata sandi..." value="password"
              class="input-clean pl-10 pr-10">
            <button type="button" onclick="togglePasswordVisibility()"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition text-sm p-1">
              👁
            </button>
          </div>
        </div>

        <!-- Remember Device -->
        <div class="flex items-center text-xs pt-0.5">
          <label class="flex items-center space-x-2 cursor-pointer text-slate-600">
            <input type="checkbox" checked class="w-3.5 h-3.5 rounded border-slate-300 text-teal-700 focus:ring-teal-500/20">
            <span class="font-medium">Ingat perangkat ini</span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-login">
          <span>MASUK KE MEJA KASIR</span>
          <span>➔</span>
        </button>

      </form>

      <!-- Login Cepat Sarah (1 user sesuai PRD) -->
      <div class="pt-4 border-t border-slate-200/70 space-y-2.5">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Login Cepat (1-Klik):</p>
        <button type="button" onclick="fillCredentials('sarah', 'password')" class="quick-btn w-full text-left p-2.5 flex items-center gap-2.5 group">
          <span class="text-base">🧺</span>
          <div>
            <div class="text-xs font-bold text-slate-800 group-hover:text-teal-800">Sarah Anggraini — Kasir &amp; Pemilik Toko</div>
            <div class="text-[10px] text-slate-500 font-mono">sarah / password</div>
          </div>
        </button>
      </div>

    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const input = document.getElementById('input-password');
      input.type = (input.type === 'password') ? 'text' : 'password';
    }

    function fillCredentials(user, pass) {
      document.getElementById('input-username').value = user;
      document.getElementById('input-password').value = pass;
    }
  </script>

</body>
</html>